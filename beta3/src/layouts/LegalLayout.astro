---
// Beta 3 privacy, cookie and accessibility pages: light header, readable column.
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Placeholder from '../components/Placeholder.astro';
interface Props { title: string; heading: string; description?: string }
const { title, heading, description } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <PageHeader title={heading}>
    <p class="updated">Last updated: <Placeholder text="publication date" /></p>
  </PageHeader>
  <section class="section legal">
    <div class="wrap">
      <div class="prose">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .updated {
    color: var(--slate);
    font-weight: 600;
  }

  .legal :global(.prose h2) {
    padding-top: 1.5rem;
    border-top: 1px solid #e3e8e6;
  }
</style>
