---
// Beta 3 service pages. Copy lives in src/data/services.ts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import ReasonList from '../../components/ReasonList.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import { services, type Service } from '../../data/services';
import { url } from '../../lib/paths';
import { brandify } from '../../lib/brand';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props { service: Service }
const { service } = Astro.props;
---
<BaseLayout title={service.seoTitle} description={service.description}>
  <PageHeader
    title={service.h1}
    intro={service.intro}
    crumbs={[{ label: 'Home', href: url('') }, { label: 'Services', href: url('services/') }, { label: service.name }]}
  >
    <p class="service-tag">
      <span class="service-tag__icon" aria-hidden="true"><ServiceIcon name={service.icon} /></span>
      <span set:html={brandify(service.name)} />
    </p>
  </PageHeader>

  <!-- Sound familiar? + What you get, side by side -->
  <section class="section" aria-label="The problem and the outcome">
    <div class="wrap pair">
      <div class="panel panel--problem">
        <h2 id="familiar-heading">Sound familiar?</h2>
        <ul class="ticks ticks--problem">
          {service.familiar.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="panel panel--outcome">
        <h2 id="get-heading">What you get</h2>
        <ul class="ticks ticks--outcome">
          {service.whatYouGet.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section band-paper" aria-labelledby="do-heading">
    <div class="wrap">
      <p class="kicker">How we help</p>
      <h2 id="do-heading">What we do</h2>
      <ReasonList items={service.whatWeDo.map((i) => ({ lead: i.term, text: i.text }))} leadSuffix=":" />
    </div>
  </section>

  <section class="section" aria-labelledby="experience-heading">
    <div class="wrap">
      <div class="experience">
        <h2 id="experience-heading" class="kicker experience__label">Where our experience comes from</h2>
        <p set:html={brandify(service.experience)} />
      </div>
    </div>
  </section>

  <section class="section band-paper others" aria-labelledby="others-heading">
    <div class="wrap">
      <!-- "Other services" heading is builder-drafted copy (brief/copy-changes.md) -->
      <h2 id="others-heading">Other services</h2>
      <ServiceCards exclude={service.slug} columns={3} />
    </div>
  </section>

  <CtaPanel button={service.cta} href={url('contact/')} />
</BaseLayout>

<style>
  .service-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.375rem 1.125rem 0.375rem 0.375rem;
    border: 1px solid #cfe9e3;
    border-radius: 2rem;
    background: #f1faf8;
    color: var(--ink);
    font-weight: 600;
  }

  .service-tag__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: #dcf3ee;
  }

  .service-tag__icon :global(.service-icon) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .pair {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 56em) {
    .pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .panel {
    padding: clamp(1.75rem, 4vw, 2.5rem);
    border-radius: 1.5rem;
  }

  .panel h2 {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.125rem);
  }

  .panel--problem {
    border: 1px solid #f3dfb8;
    background: #fff9ee;
  }

  .panel--outcome {
    border: 1px solid #cfe9e3;
    background: #effaf7;
  }

  .ticks {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .ticks li {
    position: relative;
    padding-left: 2.25rem;
    font-size: 1.0625rem;
  }

  .ticks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.15em;
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 50%;
  }

  /* Problem: amber ring with a dash */
  .ticks--problem li::before {
    border: 2px solid #b45309;
    background: linear-gradient(#b45309, #b45309) center / 0.6rem 2px no-repeat;
  }

  /* Outcome: teal tick */
  .ticks--outcome li::before {
    background: var(--teal);
  }

  .ticks--outcome li::after {
    content: '';
    position: absolute;
    left: 0.5rem;
    top: 0.42em;
    width: 0.35rem;
    height: 0.65rem;
    border: solid var(--white);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .experience {
    max-width: 56rem;
    padding-left: clamp(1.25rem, 3vw, 2rem);
    border-left: 6px solid var(--amber);
  }

  .experience__label {
    margin-bottom: 0.875rem;
    font-family: var(--font-body);
  }

  .experience p {
    font-family: var(--font-heading);
    font-size: clamp(1.375rem, 1.1rem + 1.2vw, 2.125rem);
    font-weight: 700;
    line-height: 1.3;
  }

  .others h2 {
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
  }

  @media (forced-colors: active) {
    .ticks li::before {
      border: 2px solid CanvasText;
    }
  }
</style>
