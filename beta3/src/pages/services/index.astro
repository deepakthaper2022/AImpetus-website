---
// Beta 3 Services overview – copy from brief/website-content.pdf ("Services overview page").
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import { url } from '../../lib/paths';
---
<BaseLayout
  title="Services | AImpetus"
  description="Data and platforms, AI to benefit, digital transformation and delivery assurance for public-sector and other organisations."
>
  <PageHeader
    crumbLabel="Services"
    kicker="Services"
    title="Services built around the outcome, not the technology"
    intro="We help public-sector and other organisations improve services with data, digital and AI. Each service can stand alone or work with the others, and each starts with the problem you need to solve."
  />

  <section class="section" aria-labelledby="fit-heading">
    <div class="wrap">
      <div class="fit">
        <h2 id="fit-heading">How our services fit together</h2>
        <p class="lede">Good data makes digital change possible. Good digital services give AI somewhere useful to work. Strong delivery assurance keeps all of it on track.</p>
      </div>
      <ServiceCards line="forWhen" useExplore columns={4} />
    </div>
  </section>

  <CtaPanel
    heading="Not sure where to start?"
    text="Most conversations begin with a problem, not a service. Tell us yours."
    button="Book a 30-minute conversation"
    href={url('contact/')}
  />
</BaseLayout>

<style>
  .fit {
    display: grid;
    gap: 1rem 4rem;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border-left: 8px solid var(--teal);
    border-radius: 1.5rem;
    background: linear-gradient(120deg, #e9f7f4 0%, #f4fbf9 60%, #ffffff 100%);
  }

  @media (min-width: 60em) {
    .fit {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
    }
  }

  .fit h2 {
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.75rem);
  }

  .fit .lede {
    color: var(--slate);
  }
</style>
