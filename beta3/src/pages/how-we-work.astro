---
// Beta 3 How we work – copy from brief/website-content.pdf ("How we work page").
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FeatureIcon from '../components/FeatureIcon.astro';
import ReasonList from '../components/ReasonList.astro';
import CtaPanel from '../components/CtaPanel.astro';
import { url } from '../lib/paths';
import { brandify } from '../lib/brand';
import workshopPhoto from '../assets/photos/workshop.jpg';

const approach = [
  { icon: 'target', lead: 'Understand.', text: "We start with your service, your users, your data and the outcome you need. We agree what success looks like and how we'll measure it." },
  { icon: 'evidence', lead: 'Prove.', text: 'We test the idea quickly and safely, against the measures we agreed. You see evidence, not just a demo.' },
  { icon: 'commercial', lead: 'Scale or stop.', text: "We scale what works and stop what doesn't. Then we make sure your team can run and improve it." },
] as const;

const expect = [
  { icon: 'senior', lead: 'Senior people throughout.', text: 'The founders lead every engagement, supported by trusted senior associates.' },
  { icon: 'honest', lead: 'Honest advice.', text: "We'll tell you if something isn't worth doing, or if we're not the right fit." },
  { icon: 'standards', lead: 'Your standards, not ours.', text: 'We work within your security, information governance, accessibility and service standards.' },
  { icon: 'knowledge', lead: 'Knowledge left behind.', text: "We document, coach and hand over, so you're not dependent on us." },
  { icon: 'value', lead: 'Value for money.', text: 'We size the team to the job, and nothing more.' },
] as const;

const ways = [
  { option: 'Health check or discovery', bestFor: 'Getting an independent view before you commit', how: 'A short, fixed-scope piece of work with clear recommendations' },
  { option: 'Specialist support', bestFor: 'Adding senior data, AI or delivery capability to your team', how: 'Experienced specialists working inside your team, directly or through a partner' },
  { option: 'Outcome-based project', bestFor: 'Delivering a defined result, such as a pilot or platform', how: 'A small team accountable for agreed outcomes' },
];
---
<BaseLayout
  title="How we work | AImpetus"
  description="Senior-led, partner-friendly delivery. We start small, prove the benefit, then scale what works for public-sector and other organisations."
>
  <PageHeader
    crumbLabel="How we work"
    kicker="How we work"
    title="Senior-led. Evidence-based. Easy to work with."
    intro="We keep our approach simple: understand the problem properly, prove the value early and only scale what works. Senior people stay involved throughout."
    photo={workshopPhoto}
  />

  <section class="section approach-band" aria-labelledby="approach-heading">
    <div class="wrap">
      <h2 id="approach-heading">Our approach</h2>
      <ol class="approach">
        {approach.map((step, i) => (
          <li class:list={['stage', { 'stage--split': i === 2 }]}>
            <div class="stage__top">
              <span class="stage__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="stage__icon"><FeatureIcon name={step.icon} /></span>
            </div>
            <h3>{step.lead}</h3>
            <p>{step.text}</p>
            {i === 2 && (
              <div class="stage__fork" aria-hidden="true">
                <span class="stage__fork-scale">Scale</span>
                <span class="stage__fork-stop">Stop</span>
              </div>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section band-paper" aria-labelledby="expect-heading">
    <div class="wrap">
      <h2 id="expect-heading">What you can expect from us</h2>
      <ReasonList items={expect} />
    </div>
  </section>

  <section class="section" aria-labelledby="ways-heading">
    <div class="wrap">
      <h2 id="ways-heading">Ways to work with us</h2>
      <ul class="ways">
        {ways.map((w) => (
          <li class="way">
            <h3 set:html={brandify(w.option)} />
            <dl>
              <div>
                <dt>Best for</dt>
                <dd>{w.bestFor}</dd>
              </div>
              <div>
                <dt>How it works</dt>
                <dd>{w.how}</dd>
              </div>
            </dl>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaPanel
    id="alongside-heading"
    heading="Working alongside your teams"
    text="We fit around the people already doing the work: your in-house teams, other suppliers and delivery partners. We bring senior specialists who need little supervision, work to your standards and leave knowledge behind."
    button="Book a 30-minute conversation"
    href={url('contact/')}
  />
</BaseLayout>

<style>
  h2 {
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.75rem);
  }

  /* Our approach: three stage cards joined by logo-style chevron connectors */
  .approach-band {
    background: linear-gradient(180deg, #eef8f5 0%, #f7fcfb 100%);
  }

  .approach {
    display: grid;
    gap: 2.5rem;
    margin: clamp(1.75rem, 3.5vw, 2.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 56em) {
    .approach {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem;
    }
  }

  .stage {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid #d7ece7;
    border-radius: 1.5rem;
    background: var(--white);
    box-shadow: 0 20px 40px -28px rgba(14, 42, 47, 0.35);
  }

  /* Chevron connector to the next stage (down on phones, right on wide screens) */
  .stage:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -2.1rem;
    width: 1.75rem;
    height: 1.5rem;
    background: var(--teal);
    clip-path: polygon(0 0, 50% 45%, 100% 0, 100% 55%, 50% 100%, 0 55%);
    transform: translateX(-50%);
  }

  @media (min-width: 56em) {
    .stage:not(:last-child)::after {
      left: auto;
      right: -2.35rem;
      top: 50%;
      bottom: auto;
      width: 1.5rem;
      height: 1.75rem;
      clip-path: polygon(0 0, 55% 0, 100% 50%, 55% 100%, 0 100%, 45% 50%);
      transform: translateY(-50%);
    }
  }

  .stage__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .stage__num {
    font-family: var(--font-heading);
    font-size: clamp(2.75rem, 2.2rem + 2vw, 3.75rem);
    font-weight: 700;
    line-height: 1;
    color: var(--teal);
  }

  .stage__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: #dcf3ee;
  }

  .stage h3 {
    font-size: clamp(1.375rem, 1.15rem + 0.8vw, 1.75rem);
  }

  .stage p {
    flex: 1;
    color: var(--slate);
  }

  /* Scale or stop: the decision, shown as a two-tone split */
  .stage__fork {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 0.75rem;
    border-radius: 0.75rem;
    overflow: hidden;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  .stage__fork span {
    padding: 0.625rem;
  }

  .stage__fork-scale {
    background: #c9eee6;
    color: var(--teal-dark);
  }

  .stage__fork-stop {
    background: #fdebc8;
    color: #8a4a06;
  }

  @media (forced-colors: active) {
    .stage:not(:last-child)::after {
      background: CanvasText;
    }
  }

  .ways {
    display: grid;
    gap: 1.25rem;
    margin: clamp(1.75rem, 3.5vw, 2.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 56em) {
    .ways {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .way {
    padding: 1.75rem;
    border: 1px solid #e3e8e6;
    border-top: 5px solid var(--teal);
    border-radius: 1.25rem;
    background: var(--white);
  }

  .way:nth-child(2) {
    border-top-color: var(--amber);
  }

  .way:nth-child(3) {
    border-top-color: var(--ink);
  }

  .way h3 {
    font-size: 1.375rem;
  }

  .way dl {
    margin: 1rem 0 0;
  }

  .way dl > div + div {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #e3e8e6;
  }

  .way dt {
    color: var(--teal-dark);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .way dd {
    margin: 0.25rem 0 0;
    color: var(--slate);
  }
</style>
