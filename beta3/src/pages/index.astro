---
// Beta 3 Home – light, people-first. Copy from brief/website-content.pdf ("Home
// page") with brief/copy-changes.md applied. Key-fact labels are builder-drafted.
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ArrowLink from '../components/ArrowLink.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import FeatureIcon from '../components/FeatureIcon.astro';
import FounderPortrait from '../components/FounderPortrait.astro';
import { services } from '../data/services';
import { url } from '../lib/paths';
import { brandify } from '../lib/brand';
import heroPhoto from '../assets/photos/hero.jpg';
import workshopPhoto from '../assets/photos/workshop.jpg';

const facts = [
  { value: '60', label: 'years of combined experience' },
  { value: '10+', label: 'years on NHS national programmes' },
  { value: '4', label: 'services, one aim' },
];

const why = [
  { icon: 'senior', lead: 'Senior people, start to finish.', text: 'Two founders with 60 years of combined experience. The people who scope your work lead its delivery.' },
  { icon: 'health', lead: 'We know how national health programmes work.', text: 'More than a decade delivering NHS England and NHS Improvement data, cloud and digital programmes.' },
  { icon: 'layers', lead: 'Data and digital first, so AI holds up.', text: 'We build the platforms, data and controls AI needs, then test use cases against real benefits.' },
  { icon: 'commercial', lead: 'Delivery and commercial sense together.', text: 'Experience of running a UK technology services business and large NHS delivery portfolios. Realistic plans, clear contracts, no surprises.' },
  { icon: 'partner', lead: 'Easy to work with.', text: 'Small and partner-friendly. We fit your teams and standards, and leave knowledge behind.' },
] as const;

const steps = [
  { lead: 'Understand', text: 'we start with your service, your data and the outcome you need.' },
  { lead: 'Prove', text: 'we test the idea quickly, against measures agreed up front.' },
  { lead: 'Scale or stop', text: "we scale what works, stop what doesn't, and leave your team able to run it." },
];

const founders = [
  { name: 'Prahlad Koti', slug: 'prahlad-koti', initials: 'PK', role: 'Co-founder and Managing Director', text: 'former UK Managing Director of Mastek, with more than 30 years in technology services.' },
  { name: 'Deepak Thaper', slug: 'deepak-thaper', initials: 'DT', role: 'Co-founder and Delivery & Technology Director', text: 'nearly 30 years in technology delivery, including more than a decade on NHS national programmes.' },
];
---
<BaseLayout
  light
  title="AImpetus | Data, digital and AI for public services"
  description="Better digital services, with AI in the engine room. Senior-led data, digital and AI delivery, with deep roots in the NHS and wider UK public sector."
>
  <!-- 1. Hero -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="kicker">Data, digital and AI services</p>
        <h1 id="hero-heading">Better digital services, with <span class="hero-ai">A<span class="brand-i">I</span> in the engine room.</span></h1>
        <p class="lede hero__lede">We build the data platforms, digital services and governance that let AI work safely in live services. Senior-led, with 60 years of combined experience and deep roots in the NHS and wider UK public sector.</p>
        <div class="hero__actions">
          <Button href={url('contact/')}>Book a 30-minute conversation</Button>
          <ArrowLink href={url('services/')}>See our services</ArrowLink>
        </div>
      </div>
      <div class="hero__media">
        <Picture
          src={heroPhoto}
          alt=""
          widths={[560, 760, 1100, 1452]}
          sizes="(min-width: 64em) 46vw, 92vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
          class="hero__img"
        />
      </div>
    </div>
  </section>

  <!-- Key facts -->
  <section class="facts-band band-paper" aria-label="Key facts">
    <div class="wrap">
      <ul class="facts">
        {facts.map((f) => (
          <li class="fact">
            <span class="fact__value">{f.value}</span>
            <span class="fact__label">{f.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 2. The problem we solve -->
  <section class="section" aria-labelledby="problem-heading">
    <div class="wrap split">
      <h2 id="problem-heading" class="problem__heading">A<span class="brand-i">I</span> is easy to pilot. <span class="teal">Hard to run.</span></h2>
      <p class="lede split__body">Most organisations have tried AI. Far fewer have it working in a live service. The usual blockers aren't the AI itself. They're scattered data, ageing platforms, unclear governance and programmes stretched thin. We fix the groundwork, so AI and digital change can hold up in the real world.</p>
    </div>
  </section>

  <!-- 3. Why AImpetus -->
  <section class="section band-paper" aria-labelledby="why-heading">
    <div class="wrap">
      <p class="kicker">Why AImpetus</p>
      <h2 id="why-heading" class="section__heading">Senior people. Proven delivery.</h2>
      <ol class="reasons">
        {why.map((item) => (
          <li class="reason">
            <span class="reason__icon"><FeatureIcon name={item.icon} /></span>
            <div>
              <h3 set:html={brandify(item.lead)} />
              <p>{item.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. What we do -->
  <section class="section" aria-labelledby="services-heading">
    <div class="wrap">
      <p class="kicker">What we do</p>
      <h2 id="services-heading" class="section__heading">Four services, one aim: services that work better.</h2>
      <ul class="service-cards">
        {services.map((s) => (
          <li class="service-card">
            <span class="service-card__icon"><ServiceIcon name={s.icon} /></span>
            <h3><a href={url(`services/${s.slug}/`)} class="service-card__link" set:html={brandify(s.name)} /></h3>
            <p>{s.homeLine}</p>
            <span class="service-card__more" aria-hidden="true">Explore <span class="arrow">→</span></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. How we work (summary) -->
  <section class="section band-paper" aria-labelledby="how-heading">
    <div class="wrap how">
      <div class="how__media">
        <Picture
          src={workshopPhoto}
          alt=""
          widths={[560, 800, 1200]}
          sizes="(min-width: 60em) 45vw, 92vw"
          formats={['avif', 'webp']}
          class="how__img"
        />
      </div>
      <div class="how__text">
        <p class="kicker">How we work</p>
        <h2 id="how-heading" class="section__heading">Start small. Prove it. Then scale.</h2>
        <ol class="steps">
          {steps.map((step, i) => (
            <li class="step">
              <span class="step__num" aria-hidden="true">{i + 1}</span>
              <p><strong>{step.lead}</strong> – {step.text}</p>
            </li>
          ))}
        </ol>
        <ArrowLink href={url('how-we-work/')} class="section-link">How we work</ArrowLink>
      </div>
    </div>
  </section>

  <!-- 6. Founders -->
  <section class="section" aria-labelledby="founders-heading">
    <div class="wrap">
      <p class="kicker">Our founders</p>
      <h2 id="founders-heading" class="section__heading">Led by the people who do the work</h2>
      <ul class="founders">
        {founders.map((f) => (
          <li class="founder">
            <div class="founder__photo"><FounderPortrait slug={f.slug} initials={f.initials} size="lg" /></div>
            <div>
              <h3>{f.name}<span class="visually-hidden">,</span></h3>
              <p class="founder__role">{f.role}<span class="visually-hidden"> –</span></p>
              <p>{f.text}</p>
            </div>
          </li>
        ))}
      </ul>
      <ArrowLink href={url('about/')} class="section-link">Meet the founders</ArrowLink>
    </div>
  </section>

  <!-- 7. Closing call to action -->
  <section class="cta-section" aria-labelledby="cta-heading">
    <div class="wrap">
      <div class="cta on-ink">
        <div>
          <h2 id="cta-heading" set:html={brandify('Got a data, AI or digital challenge?')} />
          <p class="lede">Tell us what you're working on. In 30 minutes we'll give you an honest view of where to start, even if that isn't with us.</p>
        </div>
        <div class="cta__action">
          <Button href={url('contact/')}>Book a 30-minute conversation</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .teal {
    color: var(--teal);
  }

  .kicker {
    margin-bottom: 0.875rem;
  }

  .section__heading {
    max-width: 22ch;
  }

  .section-link {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }

  /* ---------- Hero ---------- */
  .hero {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5.5rem);
    background:
      radial-gradient(ellipse 55% 70% at 85% 40%, rgba(94, 234, 212, 0.16), transparent 70%),
      var(--white);
  }

  .hero__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  @media (min-width: 64em) {
    .hero__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: clamp(3rem, 5vw, 5rem);
    }
  }

  .hero h1 {
    max-width: 15ch;
    font-size: clamp(2.5rem, 1.5rem + 4vw, 4.75rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  .hero-ai {
    color: var(--teal);
  }

  .hero__lede {
    max-width: 36rem;
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
    color: var(--slate);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .hero__media :global(.hero__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1452 / 941;
    object-fit: cover;
    border-radius: 1.5rem;
    box-shadow: 0 30px 60px -30px rgba(14, 42, 47, 0.45);
  }

  /* ---------- Facts ---------- */
  .facts {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40em) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .fact {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--rule-on-paper);
  }

  .fact:last-child {
    border-bottom: 0;
  }

  @media (min-width: 40em) {
    .fact {
      flex-direction: column;
      gap: 0.25rem;
      padding: 2rem clamp(1rem, 3vw, 2.5rem);
      border-bottom: 0;
    }

    .fact + .fact {
      border-left: 1px solid var(--rule-on-paper);
    }

    .fact:first-child {
      padding-left: 0;
    }
  }

  .fact__value {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    font-weight: 700;
    line-height: 1;
    color: var(--teal);
  }

  .fact__label {
    color: var(--slate);
    font-weight: 600;
  }

  /* ---------- Problem ---------- */
  .split {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 60em) {
    .split {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      column-gap: clamp(3rem, 6vw, 6rem);
      align-items: center;
    }
  }

  .problem__heading {
    font-size: clamp(2.125rem, 1.4rem + 3vw, 3.75rem);
    line-height: 1.06;
  }

  .split__body {
    max-width: var(--measure);
    color: var(--slate);
  }

  /* ---------- Why: headed list, no boxes ---------- */
  .reasons {
    display: grid;
    gap: 0 clamp(2rem, 5vw, 4rem);
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48em) {
    .reasons {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .reason {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--rule-on-paper);
  }

  .reason__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: #dcf3ee;
  }

  .reason h3 {
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .reason p {
    margin-top: 0.375rem;
    color: var(--slate);
  }

  /* ---------- Services ---------- */
  .service-cards {
    display: grid;
    gap: 1.25rem;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40em) {
    .service-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72em) {
    .service-cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    border: 1px solid #e3e8e6;
    border-radius: 1.25rem;
    background: var(--white);
    box-shadow: 0 1px 2px rgba(14, 42, 47, 0.04);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .service-card:hover,
  .service-card:focus-within {
    transform: translateY(-4px);
    border-color: #b7dcd5;
    box-shadow: 0 24px 44px -28px rgba(14, 42, 47, 0.4);
  }

  .service-card__icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: 0.5rem;
    border-radius: 1rem;
    background: #dcf3ee;
  }

  .service-card__icon :global(.service-icon) {
    width: 2.25rem;
    height: 2.25rem;
  }

  .service-card h3 {
    font-size: 1.375rem;
  }

  .service-card__link {
    color: var(--ink);
    text-decoration: none;
  }

  .service-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 1.25rem;
  }

  .service-card__link:focus-visible {
    outline: none;
  }

  .service-card__link:focus-visible::after {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  .service-card p {
    flex: 1;
    color: var(--slate);
  }

  .service-card__more {
    color: var(--teal-dark);
    font-weight: 600;
  }

  .service-card__more .arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .service-card:hover .service-card__more .arrow {
    transform: translateX(4px);
  }

  .service-card:hover .service-card__link {
    text-decoration: underline;
  }

  /* ---------- How we work ---------- */
  .how {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 60em) {
    .how {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .how__media :global(.how__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 1.5rem;
  }

  .steps {
    display: grid;
    gap: 1.25rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .step__num {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--teal);
    color: var(--white);
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .step p {
    padding-top: 0.35rem;
    font-size: 1.125rem;
  }

  /* ---------- Founders ---------- */
  .founders {
    display: grid;
    gap: 1.25rem;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48em) {
    .founders {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .founder {
    display: grid;
    gap: 1.5rem;
    padding: 1.5rem;
    border: 1px solid #e3e8e6;
    border-radius: 1.25rem;
    background: var(--white);
  }

  @media (min-width: 30em) {
    .founder {
      grid-template-columns: 9rem minmax(0, 1fr);
      align-items: center;
    }
  }

  .founder__photo {
    width: min(100%, 9rem);
  }

  .founder__photo :global(.portrait__img) {
    border-radius: 1rem;
    box-shadow: none;
  }

  .founder__photo :global(.portrait__mark) {
    display: none;
  }

  .founder h3 {
    font-size: 1.5rem;
  }

  .founder__role {
    margin-block: 0.25rem 0.625rem;
    color: var(--teal-dark);
    font-weight: 600;
  }

  .founder p:last-child {
    color: var(--slate);
  }

  /* ---------- CTA ---------- */
  .cta-section {
    padding-block: 0 var(--section-space);
  }

  .cta {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: clamp(2rem, 5vw, 4.5rem);
    border-radius: 1.75rem;
    background:
      radial-gradient(ellipse 60% 120% at 100% 0%, rgba(94, 234, 212, 0.22), transparent 60%),
      linear-gradient(120deg, var(--ink) 40%, #0f4a47 100%);
  }

  @media (min-width: 60em) {
    .cta {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4rem;
    }
  }

  .cta h2 {
    max-width: 18ch;
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.5rem);
    line-height: 1.06;
  }

  .cta .lede {
    max-width: 36rem;
    margin-top: 1.25rem;
  }
</style>
