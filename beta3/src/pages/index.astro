---
// Beta 3 Home – Engine room: Schematic. Copy from brief/website-content.pdf ("Home
// page") with brief/copy-changes.md applied. Diagram labels reuse the service names.
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ArrowLink from '../components/ArrowLink.astro';
import SystemDiagram from '../components/SystemDiagram.astro';
import FeatureIcon from '../components/FeatureIcon.astro';
import FounderPortrait from '../components/FounderPortrait.astro';
import { services } from '../data/services';
import { url } from '../lib/paths';
import { brandify } from '../lib/brand';

const why = [
  { icon: 'senior', lead: 'Senior people, start to finish.', text: 'Two founders with 60 years of combined experience. The people who scope your work lead its delivery.' },
  { icon: 'health', lead: 'We know how national health programmes work.', text: 'More than a decade delivering NHS England and NHS Improvement data, cloud and digital programmes.' },
  { icon: 'layers', lead: 'Data and digital first, so AI holds up.', text: 'We build the platforms, data and controls AI needs, then test use cases against real benefits.' },
  { icon: 'commercial', lead: 'Delivery and commercial sense together.', text: 'Experience of running a UK technology services business and large NHS delivery portfolios. Realistic plans, clear contracts, no surprises.' },
  { icon: 'partner', lead: 'Easy to work with.', text: 'Small and partner-friendly. We fit your teams and standards, and leave knowledge behind.' },
] as const;

const parts = { 'data-and-platforms': 'data', 'ai-to-benefit': 'ai', 'digital-transformation': 'digital', 'delivery-assurance': 'assurance' } as const;

const steps = [
  { lead: 'Understand', text: 'we start with your service, your data and the outcome you need.' },
  { lead: 'Prove', text: 'we test the idea quickly, against measures agreed up front.' },
  { lead: 'Scale or stop', text: "we scale what works, stop what doesn't, and leave your team able to run it." },
];

const founders = [
  { name: 'Prahlad Koti', slug: 'prahlad-koti', initials: 'PK', role: 'Co-founder and Managing Director', text: 'former UK Managing Director of Mastek, with more than 30 years in technology services.' },
  { name: 'Deepak Thaper', slug: 'deepak-thaper', initials: 'DT', role: 'Co-founder and Delivery & Technology Director', text: 'nearly 30 years in technology delivery, including more than a decade on NHS national programmes.' },
];
---
<BaseLayout
  title="AImpetus | Data, digital and AI for public services"
  description="Better digital services, with AI in the engine room. Senior-led data, digital and AI delivery, with deep roots in the NHS and wider UK public sector."
>
  <!-- 1. Hero -->
  <section class="hero blueprint" aria-labelledby="hero-heading">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="annot">Data, digital and AI services</p>
        <h1 id="hero-heading">Better digital services, with <span class="hero-ai">A<span class="brand-i">I</span></span> in the engine room.</h1>
        <p class="lede hero__lede">We build the data platforms, digital services and governance that let AI work safely in live services. Senior-led, with 60 years of combined experience and deep roots in the NHS and wider UK public sector.</p>
        <div class="hero__actions">
          <Button href={url('contact/')}>Book a 30-minute conversation</Button>
          <ArrowLink href={url('services/')}>See our services</ArrowLink>
        </div>
      </div>
      <div class="hero__diagram">
        <SystemDiagram idPrefix="hero" />
      </div>
    </div>
  </section>

  <!-- 2. The problem we solve -->
  <section class="section band-deep cut problem" aria-labelledby="problem-heading">
    <div class="wrap problem__inner">
      <div>
        <p class="annot" aria-hidden="true">01</p>
        <h2 id="problem-heading"><span class="problem__easy">A<span class="brand-i">I</span> is easy to pilot.</span> <span class="problem__hard">Hard to run.</span></h2>
      </div>
      <div class="problem__body">
        <p class="lede">Most organisations have tried AI. Far fewer have it working in a live service. The usual blockers aren't the AI itself. They're scattered data, ageing platforms, unclear governance and programmes stretched thin. We fix the groundwork, so AI and digital change can hold up in the real world.</p>
        <!-- Decorative: a pilot that never connects to the live service -->
        <svg class="gap-line" viewBox="0 0 520 90" aria-hidden="true" focusable="false">
          <line x1="20" y1="45" x2="220" y2="45" class="gap-line__run" />
          <line x1="300" y1="45" x2="500" y2="45" class="gap-line__run gap-line__run--dim" />
          <circle cx="20" cy="45" r="12" class="gap-line__node" />
          <circle cx="500" cy="45" r="12" class="gap-line__node gap-line__node--dim" />
          <path d="M 236 25 l 20 40 M 264 25 l 20 40" class="gap-line__break" />
        </svg>
      </div>
    </div>
  </section>

  <!-- 3. Why AImpetus -->
  <section class="section blueprint cut why" aria-labelledby="why-heading">
    <div class="wrap">
      <p class="annot" aria-hidden="true">02</p>
      <h2 id="why-heading">Senior people. Proven delivery.</h2>
      <ol class="bus">
        {why.map((item, i) => (
          <li class="bus__item">
            <span class="bus__node" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="spec bus__card">
              <span class="bus__icon"><FeatureIcon name={item.icon} /></span>
              <div>
                <h3 set:html={brandify(item.lead)} />
                <p>{item.text}</p>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. What we do -->
  <section class="section band-deep cut" aria-labelledby="services-heading">
    <div class="wrap">
      <p class="annot" aria-hidden="true">03</p>
      <h2 id="services-heading" class="services__heading">Four services, one aim: services that work better.</h2>
      <ul class="modules">
        {services.map((s) => (
          <li class="spec module">
            <div class="module__diagram">
              <SystemDiagram highlight={parts[s.slug as keyof typeof parts]} compact idPrefix={`m-${s.slug}`} />
            </div>
            <h3 class="module__name"><a href={url(`services/${s.slug}/`)} class="module__link" set:html={brandify(s.name)} /></h3>
            <p class="module__line">{s.homeLine}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. How we work (summary) -->
  <section class="section blueprint cut" aria-labelledby="how-heading">
    <div class="wrap">
      <p class="annot" aria-hidden="true">04</p>
      <h2 id="how-heading">Start small. Prove it. Then scale.</h2>
      <!-- Decorative route map; the steps below say the same in words -->
      <svg class="route" viewBox="0 0 1000 120" aria-hidden="true" focusable="false">
        <path d="M 40 60 H 760" class="route__track" />
        <path d="M 40 60 H 760" class="route__flow" />
        <path d="M 760 60 C 820 60, 840 20, 900 20 H 960" class="route__track route__track--scale" />
        <path d="M 760 60 C 820 60, 840 100, 900 100 H 930" class="route__track route__track--stop" />
        <path d="M 930 88 l 24 24 M 954 88 l -24 24" class="route__stop" />
        <polygon points="950,8 968,20 950,32" class="route__arrow" />
        {[40, 400, 760].map((x, i) => (
          <g>
            <circle cx={x} cy="60" r="26" class="route__station" />
            <text x={x} y="68" text-anchor="middle" class="route__num">{i + 1}</text>
          </g>
        ))}
      </svg>
      <ol class="stations">
        {steps.map((step, i) => (
          <li class="station">
            <span class="station__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <p><strong>{step.lead}</strong> – {step.text}</p>
          </li>
        ))}
      </ol>
      <ArrowLink href={url('how-we-work/')} class="section-link">How we work</ArrowLink>
    </div>
  </section>

  <!-- 6. Founders -->
  <section class="section band-deep cut" aria-labelledby="founders-heading">
    <div class="wrap">
      <p class="annot" aria-hidden="true">05</p>
      <h2 id="founders-heading">Led by the people who do the work</h2>
      <ul class="founders">
        {founders.map((f) => (
          <li class="spec founder">
            <div class="founder__photo"><FounderPortrait slug={f.slug} initials={f.initials} size="lg" /></div>
            <div>
              <h3>{f.name}<span class="visually-hidden">,</span></h3>
              <p class="founder__role">{f.role}<span class="visually-hidden"> –</span></p>
              <p>{f.text}</p>
            </div>
          </li>
        ))}
      </ul>
      <ArrowLink href={url('about/')} class="section-link">Meet the founders</ArrowLink>
    </div>
  </section>

  <!-- 7. Closing call to action -->
  <section class="section cta cut" aria-labelledby="cta-heading">
    <div class="wrap cta__inner">
      <h2 id="cta-heading" set:html={brandify('Got a data, AI or digital challenge?')} />
      <p class="lede">Tell us what you're working on. In 30 minutes we'll give you an honest view of where to start, even if that isn't with us.</p>
      <div class="cta__action">
        <svg class="cta__wire" viewBox="0 0 200 20" aria-hidden="true" focusable="false">
          <line x1="0" y1="10" x2="186" y2="10" class="cta__wire-line" />
          <circle cx="190" cy="10" r="6" class="cta__wire-node" />
        </svg>
        <Button href={url('contact/')}>Book a 30-minute conversation</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section > .wrap > h2,
  .section .wrap > div > h2 {
    margin-top: 1rem;
    max-width: 22ch;
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) clamp(4rem, 3rem + 5vw, 7rem);
  }

  .hero__inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 64em) {
    .hero__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: clamp(2rem, 4vw, 4rem);
    }
  }

  .hero h1 {
    max-width: 14ch;
    margin-top: 1.25rem;
    font-size: clamp(2.5rem, 1.4rem + 4.6vw, 5.25rem);
  }

  .hero-ai {
    color: var(--mint);
  }

  .hero__lede {
    max-width: 36rem;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: clamp(2rem, 4vw, 2.75rem);
  }

  .hero__diagram {
    margin-inline: -0.5rem;
  }

  @media (min-width: 64em) {
    .hero__diagram {
      margin-right: calc(-1 * var(--gutter));
    }
  }

  /* ---------- Problem ---------- */
  .problem__inner {
    display: grid;
    gap: 2rem;
    align-items: end;
  }

  @media (min-width: 60em) {
    .problem__inner {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      column-gap: clamp(3rem, 6vw, 6rem);
    }
  }

  .problem h2 {
    font-size: var(--step-4);
    line-height: 1.02;
    max-width: none;
  }

  .problem__easy {
    display: block;
    color: var(--muted-on-ink);
  }

  .problem__hard {
    display: block;
    color: var(--mint);
  }

  .problem__body {
    max-width: var(--measure);
  }

  .gap-line {
    width: 100%;
    max-width: 26rem;
    height: auto;
    margin-top: 2rem;
  }

  .gap-line__run {
    stroke: var(--mint);
    stroke-width: 4;
    stroke-dasharray: 6 10;
    animation: flow 1.4s linear infinite;
  }

  .gap-line__run--dim {
    stroke: #3b6168;
    animation: none;
  }

  .gap-line__node {
    fill: var(--ink-deeper);
    stroke: var(--mint);
    stroke-width: 3;
  }

  .gap-line__node--dim {
    stroke: #3b6168;
  }

  .gap-line__break {
    stroke: var(--amber);
    stroke-width: 4;
    stroke-linecap: round;
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -32;
    }
  }

  /* ---------- Why: spec frames on a circuit bus ---------- */
  .bus {
    position: relative;
    display: grid;
    gap: 1rem;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0 0 0 3.5rem;
    list-style: none;
  }

  /* The bus line */
  .bus::before {
    content: '';
    position: absolute;
    top: 1.5rem;
    bottom: 1.5rem;
    left: 1.25rem;
    width: 2px;
    background: linear-gradient(var(--mint), #3b6168);
  }

  @media (min-width: 56em) {
    .bus {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
    }

    .bus__item:first-child {
      grid-column: 1 / -1;
    }
  }

  .bus__item {
    position: relative;
  }

  .bus__node {
    position: absolute;
    top: 1.5rem;
    left: -3.5rem;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 2px solid var(--mint);
    border-radius: 50%;
    background: var(--ink);
    color: var(--mint);
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 700;
  }

  /* Wire from the bus to the card */
  .bus__node::after {
    content: '';
    position: absolute;
    left: 100%;
    top: 50%;
    width: 1rem;
    height: 2px;
    background: var(--mint);
  }

  @media (min-width: 56em) {
    .bus__item:nth-child(n + 2) .bus__node {
      display: none;
    }

    .bus__item:nth-child(3) .bus__node,
    .bus__item:nth-child(5) .bus__node {
      display: grid;
    }
  }

  .bus__card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.25rem;
    height: 100%;
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  .bus__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--line);
    background: rgba(94, 234, 212, 0.08);
  }

  .bus__card h3 {
    font-size: clamp(1.1875rem, 1.05rem + 0.5vw, 1.4375rem);
  }

  .bus__card p {
    margin-top: 0.5rem;
    color: var(--muted-on-ink);
  }

  .bus__item:first-child .bus__card h3 {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.125rem);
  }

  .bus__item:first-child .bus__card p {
    color: var(--paper);
    font-size: var(--step-1);
  }

  /* ---------- Services: diagram modules ---------- */
  .services__heading {
    max-width: 24ch !important;
  }

  .modules {
    display: grid;
    gap: 1.25rem;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48em) {
    .modules {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .module {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .module:hover,
  .module:focus-within {
    border-color: var(--mint);
    transform: translateY(-3px);
  }

  .module__diagram {
    margin-bottom: 0.5rem;
    padding: 0.75rem;
    border: 1px dashed var(--line);
    background:
      linear-gradient(to right, rgba(94, 234, 212, 0.05) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(to bottom, rgba(94, 234, 212, 0.05) 1px, transparent 1px) 0 0 / 24px 24px;
  }

  .module__name {
    font-size: clamp(1.375rem, 1.15rem + 0.9vw, 1.75rem);
  }

  .module__link {
    color: var(--white);
    text-decoration: none;
  }

  .module__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .module:hover .module__link {
    color: var(--mint);
    text-decoration: underline;
  }

  .module__link:focus-visible {
    outline: none;
  }

  .module__link:focus-visible::after {
    outline: var(--focus-width) solid var(--white);
    outline-offset: 3px;
  }

  .module__line {
    color: var(--muted-on-ink);
  }

  /* ---------- How: route map ---------- */
  .route {
    display: none;
    width: 100%;
    height: auto;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 48em) {
    .route {
      display: block;
    }
  }

  .route__track {
    fill: none;
    stroke: #17434a;
    stroke-width: 10;
    stroke-linecap: round;
  }

  .route__track--scale {
    stroke: var(--mint);
    stroke-width: 4;
  }

  .route__track--stop {
    stroke: #3b6168;
    stroke-width: 4;
    stroke-dasharray: 6 8;
  }

  .route__flow {
    fill: none;
    stroke: var(--mint);
    stroke-width: 3;
    stroke-dasharray: 4 14;
    animation: flow 1.4s linear infinite;
  }

  .route__stop {
    stroke: var(--amber);
    stroke-width: 4;
    stroke-linecap: round;
  }

  .route__arrow {
    fill: var(--mint);
  }

  .route__station {
    fill: var(--ink);
    stroke: var(--mint);
    stroke-width: 3;
  }

  .route__num {
    fill: var(--mint);
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 700;
  }

  .stations {
    display: grid;
    gap: 1.25rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48em) {
    .stations {
      grid-template-columns: 36% 36% 28%;
      gap: 0;
    }

    .station {
      padding-right: 2rem;
    }

    .station__num {
      display: none;
    }
  }

  .station {
    display: flex;
    gap: 1rem;
  }

  .station__num {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 2px solid var(--mint);
    border-radius: 50%;
    color: var(--mint);
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .station p {
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .section-link {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  /* ---------- Founders ---------- */
  .founders {
    display: grid;
    gap: 1.25rem;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48em) {
    .founders {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .founder {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  @media (min-width: 30em) {
    .founder {
      grid-template-columns: 9rem minmax(0, 1fr);
      align-items: start;
    }
  }

  .founder__photo {
    width: min(100%, 9rem);
  }

  .founder__photo :global(.portrait__img) {
    border-radius: 0;
    box-shadow: 0 0 0 1px var(--line);
  }

  .founder__photo :global(.portrait__mark) {
    border-radius: 0.25rem;
    box-shadow: 0 0 0 2px var(--mint);
  }

  .founder h3 {
    font-size: 1.5rem;
  }

  .founder__role {
    margin-block: 0.375rem 0.75rem;
    color: var(--mint);
    font-weight: 600;
  }

  /* ---------- CTA ---------- */
  .cta {
    background:
      radial-gradient(ellipse 60% 120% at 100% 0%, rgba(94, 234, 212, 0.16), transparent 60%),
      linear-gradient(120deg, var(--ink-deeper) 30%, #0f4a47 100%);
  }

  .cta h2 {
    max-width: 16ch;
    font-size: var(--step-4);
    line-height: 1.04;
  }

  .cta .lede {
    max-width: 36rem;
    margin-top: 1.5rem;
  }

  .cta__action {
    display: flex;
    align-items: center;
    gap: 0;
    margin-top: 2.25rem;
  }

  .cta__wire {
    display: none;
    width: 10rem;
    height: 1rem;
  }

  @media (min-width: 48em) {
    .cta__wire {
      display: block;
    }
  }

  .cta__wire-line {
    stroke: var(--mint);
    stroke-width: 2;
    stroke-dasharray: 4 8;
    animation: flow 1.4s linear infinite;
  }

  .cta__wire-node {
    fill: var(--mint);
  }

  @media (prefers-reduced-motion: reduce) {
    .gap-line__run,
    .route__flow,
    .cta__wire-line {
      animation: none;
    }
  }
</style>
