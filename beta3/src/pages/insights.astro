---
// Beta 3 Insights – copy from brief/website-content.pdf ("Insights page"). The
// "coming soon" line is builder-drafted copy (brief/copy-changes.md).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Placeholder from '../components/Placeholder.astro';
import { COMPANY_LINKEDIN } from '../lib/site';
---
<BaseLayout
  title="Insights | AImpetus"
  description="Practical thinking on data, digital and AI in national health and public services, from the AImpetus founders."
>
  <PageHeader
    title="Insights"
    intro="Practical thinking on making data, digital and AI work in public services. No hype, just what we've learned from delivery."
  >
    <p class="follow">
      {COMPANY_LINKEDIN ? (
        <a href={COMPANY_LINKEDIN}>Follow AImpetus on LinkedIn</a>
      ) : (
        <>Follow AImpetus on LinkedIn <Placeholder text="company LinkedIn page" /></>
      )}
    </p>
    <div slot="media" class="stack" aria-hidden="true">
      {[0, 1, 2].map((i) => (
        <div class={`stack__card stack__card--${i}`}>
          <span class="stack__img">
            {i === 2 && (
              <svg viewBox="0 0 48 48" focusable="false">
                <polygon points="9,12 18,12 28,24 18,36 9,36 19,24" fill="#F59E0B" />
                <polygon points="22,12 30,12 40,24 30,36 22,36 32,24" fill="#5EEAD4" />
              </svg>
            )}
          </span>
          <span class="stack__line stack__line--title"></span>
          <span class="stack__line stack__line--title stack__line--short"></span>
          <span class="stack__line"></span>
          <span class="stack__line stack__line--short"></span>
        </div>
      ))}
    </div>
  </PageHeader>

  <section class="section band-paper">
    <div class="wrap">
      <!-- TODO: copy to approve (not in the brief) -->
      <p class="soon">Our first articles are coming soon. Follow us on LinkedIn to see them first.</p>
      <ul class="placeholders" aria-hidden="true">
        {[1, 2, 3].map(() => (
          <li class="ph">
            <span class="ph__img"></span>
            <span class="ph__line ph__line--title"></span>
            <span class="ph__line ph__line--title ph__line--short"></span>
            <span class="ph__line"></span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .stack {
    position: relative;
    height: 22rem;
  }

  .stack__card {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    gap: 0.75rem;
    width: min(100%, 19rem);
    padding: 1rem 1rem 1.5rem;
    border: 1px solid #e3e8e6;
    border-radius: 1.25rem;
    background: var(--white);
    box-shadow: 0 24px 48px -28px rgba(14, 42, 47, 0.45);
  }

  .stack__card--0 { transform: translate(-62%, -50%) rotate(-8deg); }
  .stack__card--1 { transform: translate(-38%, -52%) rotate(5deg); }
  .stack__card--2 { transform: translate(-50%, -48%); }

  .stack__img {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    margin-bottom: 0.25rem;
    border-radius: 0.875rem;
    background: linear-gradient(120deg, #dcf3ee, #f1faf8);
  }

  .stack__card--2 .stack__img {
    background: linear-gradient(120deg, var(--ink), #0f4a47);
  }

  .stack__img svg {
    width: 3.5rem;
    height: 3.5rem;
  }

  .stack__line {
    height: 0.625rem;
    border-radius: 1rem;
    background: #e5eae8;
  }

  .stack__line--title {
    height: 0.875rem;
    background: #d3dcd9;
  }

  .stack__line--short {
    width: 60%;
  }

  .follow {
    font-weight: 600;
  }

  .soon {
    max-width: 36rem;
    padding: 1.5rem 1.75rem;
    border-left: 6px solid var(--teal);
    border-radius: 0 1.25rem 1.25rem 0;
    background: var(--white);
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 1.1rem + 0.8vw, 1.625rem);
    font-weight: 700;
    line-height: 1.3;
  }

  .placeholders {
    display: grid;
    gap: 1.25rem;
    margin: clamp(2rem, 4vw, 2.75rem) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48em) {
    .placeholders {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .ph {
    display: grid;
    gap: 0.75rem;
    padding: 1rem 1rem 1.5rem;
    border: 1px dashed #c7d3cf;
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.6);
  }

  .ph__img {
    aspect-ratio: 16 / 9;
    margin-bottom: 0.5rem;
    border-radius: 0.875rem;
    background: linear-gradient(120deg, #e3f3ef, #f1f5f3);
  }

  .ph__line {
    height: 0.75rem;
    border-radius: 1rem;
    background: #e5eae8;
  }

  .ph__line--title {
    height: 1rem;
    background: #d8dfdc;
  }

  .ph__line--short {
    width: 60%;
  }
</style>
