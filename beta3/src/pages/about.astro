---
// Beta 3 About us – copy from brief/website-content.pdf ("About us page").
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ReasonList from '../components/ReasonList.astro';
import FounderPortrait from '../components/FounderPortrait.astro';
import ArrowLink from '../components/ArrowLink.astro';
import CtaPanel from '../components/CtaPanel.astro';
import HeaderCard from '../components/HeaderCard.astro';

// Facts restated from the About and Home copy (labels: brief/copy-changes.md)
const facts = [
  { value: '2026', label: 'Founded' },
  { value: '60', label: 'years of combined experience' },
  { value: '2', label: 'founders, leading every engagement' },
  { value: '10+', label: 'years on NHS national programmes' },
];
import { url } from '../lib/paths';

const whyNow = [
  { icon: 'target', lead: 'Outcomes, not hype.', text: 'The real test is benefit delivered: better services, lower costs and measurable impact. Technology is the means, not the goal.' },
  { icon: 'organisation', lead: 'Understanding the business matters as much as the technology.', text: 'AI and digital tools move fast. Knowing how an organisation really works, its people, pressures and priorities, matters just as much.' },
  { icon: 'foundation', lead: 'The groundwork is the gap.', text: "The tools are ready. What often isn't ready is the data, the platforms and the governance underneath. That's exactly where we work." },
] as const;

const founders = [
  {
    id: 'prahlad',
    slug: 'prahlad-koti',
    name: 'Prahlad Koti',
    initials: 'PK',
    role: 'Co-founder and Managing Director',
    bio: [
      'Prahlad has spent more than 30 years building and running technology services businesses in the UK. At Mastek he rose from a technical support role to UK Managing Director, having led its Government and Health business and set up its healthcare practice. Along the way he led major public-sector bids, including the pricing and negotiation of a nine-year contract, and grew a FTSE 100 healthcare account threefold in five years.',
      'He went on to become a Partner at Netcompany and Chief Operating Officer at Scrumconnect Consulting, a UK digital company focused on public-sector services. He also advises founders and boards on growth and operational resilience.',
      'At AImpetus, Prahlad leads commercial strategy, partnerships and business development. He holds an MBA from London Business School and a degree in Computer Science.',
    ],
    linkedin: 'https://www.linkedin.com/in/prahlad-koti/',
    linkText: 'Connect with Prahlad on LinkedIn',
  },
  {
    id: 'deepak',
    slug: 'deepak-thaper',
    name: 'Deepak Thaper',
    initials: 'DT',
    role: 'Co-founder and Delivery & Technology Director',
    bio: [
      "Deepak has spent nearly 30 years delivering technology programmes, the last decade and more inside the NHS. At Mastek he led data warehousing and analytics work for NHS Improvement. He then directed NHS England programmes spanning cloud, DevOps and modern data platforms such as Azure Synapse and Palantir Foundry, before becoming Vice President of Delivery for UK Healthcare. His NHS cloud work earned Mastek's CEO Award for Excellence.",
      'More recently he has led delivery and strategy within AI-native organisations and the AI start-up ecosystem, helping organisations move from AI experiments to practical, well-governed adoption.',
      'At AImpetus, Deepak leads delivery, architecture and AI. He holds an MBA, a professional certificate in applied data science and AI/ML from IIT Palakkad, AgilePM Practitioner certification, and certifications in AI security and governance.',
    ],
    linkedin: 'https://www.linkedin.com/in/deepak-thaper-80246113/',
    linkText: 'Connect with Deepak on LinkedIn',
  },
];

const beliefs = [
  { icon: 'target', lead: 'Outcomes before technology.', text: 'We start with the service and the people who use it.' },
  { icon: 'evidence', lead: 'Evidence before scale.', text: 'Prove it works, then grow it.' },
  { icon: 'honest', lead: 'Honesty before sales.', text: "We'd rather lose a deal than oversell." },
  { icon: 'public', lead: 'Public value.', text: 'Every pound of public money should do real work.' },
] as const;
---
<BaseLayout
  title="About us | AImpetus"
  description="AImpetus is a UK data, digital and AI services company founded by Prahlad Koti and Deepak Thaper, with 60 years of combined experience."
>
  <PageHeader
    crumbLabel="About us"
    kicker="About us"
    title="A new company. A proven team."
    intro="AImpetus is a UK data, digital and AI services company. We were founded in 2026 by two people who have spent their careers delivering technology for the NHS and the wider public sector."
  >
    <HeaderCard slot="media">
      <dl class="facts">
        {facts.map((f) => (
          <div class="fact">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
      <p class="facts__note">NHS England · NHS Improvement · UK public sector</p>
    </HeaderCard>
  </PageHeader>

  <section class="section" aria-labelledby="started-heading">
    <div class="wrap">
      <div class="story">
        <h2 id="started-heading">Why we started A<span class="brand-i">I</span>mpetus</h2>
        <div>
          <p class="lede">We've seen too many promising data and AI ideas stall before they reached a live service. The technology usually works. What's missing is the groundwork: reliable data, modern platforms, sound governance and steady delivery. AImpetus exists to put that groundwork in place, so AI can do real work in the engine room of public services.</p>
          <p class="name-note">The name says what we're for: AI, and the impetus to move good ideas into everyday use.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section band-paper" aria-labelledby="now-heading">
    <div class="wrap">
      <div class="now-intro">
        <h2 id="now-heading">Why now</h2>
        <p class="lede">AI has moved from experiment to expectation. But the organisations that gain most won't be the ones with the most technology. They'll be the ones that stay focused on outcomes. That's why we started AImpetus now.</p>
      </div>
      <ReasonList items={whyNow} />
      <p class="lede now-close">We both stepped out of conventional IT services to see the work from a different angle: new technology, new ways of delivering services, and the ground reality of making change stick. AImpetus brings that experience together, so the organisations we work with get the benefit, not the hype.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="founders-heading">
    <div class="wrap">
      <h2 id="founders-heading">Our founders</h2>
      <div class="profiles">
        {founders.map((f) => (
          <article class="profile" aria-labelledby={`${f.id}-name`}>
            <div class="profile__photo"><FounderPortrait slug={f.slug} initials={f.initials} size="lg" /></div>
            <div class="profile__body">
              <h3 id={`${f.id}-name`}>{f.name}</h3>
              <p class="profile__role">{f.role}</p>
              <div class="profile__bio">
                {f.bio.map((para) => <p>{para}</p>)}
              </div>
              <ArrowLink href={f.linkedin}>{f.linkText}</ArrowLink>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section band-paper" aria-labelledby="believe-heading">
    <div class="wrap">
      <h2 id="believe-heading">What we believe</h2>
      <ReasonList items={beliefs} />
    </div>
  </section>

  <CtaPanel button="Book a 30-minute conversation" href={url('contact/')} />
</BaseLayout>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
  }

  .fact {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.375rem;
    min-height: 8.5rem;
    padding: 1.125rem 1.25rem;
    border-radius: 1rem;
    background: #f1faf8;
  }

  .fact:first-child {
    background: var(--ink);
  }

  .fact dd {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 1.8rem + 1.5vw, 3rem);
    font-weight: 700;
    line-height: 1;
    color: var(--teal);
  }

  .fact:first-child dd {
    color: var(--mint);
  }

  .fact dt {
    color: var(--slate);
    font-weight: 600;
    line-height: 1.35;
  }

  .fact:first-child dt {
    color: var(--muted-on-ink);
  }

  .facts__note {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #e3e8e6;
    color: var(--teal-dark);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h2 {
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.75rem);
  }

  .kicker {
    margin-bottom: 0.75rem;
  }

  .story,
  .now-intro {
    display: grid;
    gap: 1.25rem 4rem;
  }

  @media (min-width: 60em) {
    .story,
    .now-intro {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      align-items: start;
    }
  }

  .story .lede,
  .now-intro .lede,
  .now-close {
    color: var(--slate);
  }

  .name-note {
    margin-top: 1.5rem;
    padding: 1.25rem 1.5rem;
    border-left: 6px solid var(--teal);
    border-radius: 0 1rem 1rem 0;
    background: linear-gradient(120deg, #e9f7f4, #f7fcfb);
    color: var(--ink);
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .now-close {
    max-width: 52rem;
    margin-top: 2rem;
  }

  .profiles {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .profile {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid #e3e8e6;
    border-radius: 1.5rem;
    background: var(--white);
  }

  @media (min-width: 48em) {
    .profile {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: clamp(2rem, 4vw, 3rem);
      align-items: start;
    }
  }

  .profile__photo {
    width: min(100%, 13rem);
  }

  .profile__photo :global(.portrait__img) {
    border-radius: 1.25rem;
    box-shadow: none;
  }

  .profile__photo :global(.portrait__mark) {
    display: none;
  }

  .profile h3 {
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
  }

  .profile__role {
    margin-top: 0.375rem;
    color: var(--teal-dark);
    font-weight: 600;
  }

  .profile__bio {
    max-width: 46rem;
    margin-block: 1rem;
    color: var(--slate);
  }
</style>
