---
// Beta 3 interior page header: white, breadcrumb, H1 and intro. With a photo it is
// a two-column hero (photo on the right, logo stripes behind it); without one, pale
// logo stripes sit on the right on wide screens only.
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';
import PhotoFrame from './PhotoFrame.astro';
import LogoStripes from './LogoStripes.astro';
import { brandify } from '../lib/brand';
import { url } from '../lib/paths';

interface Crumb { label: string; href?: string }
interface Props {
  title: string;
  intro?: string;
  kicker?: string;
  crumbs?: Crumb[];
  crumbLabel?: string;
  photo?: ImageMetadata;
  stripes?: 'pair' | 'tint' | false;
}
const { title, intro, kicker, crumbs, crumbLabel, photo, stripes = 'tint' } = Astro.props;
const trail = crumbs ?? [{ label: 'Home', href: url('') }, { label: crumbLabel ?? title }];
const hasMedia = Boolean(photo) || Astro.slots.has('media');
---
<section class:list={['page-header', { 'page-header--photo': hasMedia }]} aria-labelledby="page-title">
  {stripes && <div class="page-header__stripes"><LogoStripes variant={stripes} /></div>}
  <div class="wrap page-header__inner">
    <div class="page-header__text">
      <Breadcrumbs items={trail} />
      {kicker && <p class="kicker">{kicker}</p>}
      <h1 id="page-title" set:html={brandify(title)} />
      {intro && <p class="lede page-header__intro">{intro}</p>}
      <slot />
    </div>
    {photo && (
      <div class="page-header__media">
        <PhotoFrame src={photo} eager ratio="3 / 2" />
      </div>
    )}
    {!photo && hasMedia && (
      <div class="page-header__media page-header__card">
        <slot name="media" />
      </div>
    )}
  </div>
</section>

<style>
  .page-header {
    --stripe-pad: clamp(1.75rem, 1rem + 2.5vw, 3.25rem);
    position: relative;
    overflow: hidden;
    padding-block: var(--stripe-pad);
    border-bottom: 1px solid #e3e8e6;
    background:
      radial-gradient(ellipse 50% 80% at 90% 30%, rgba(94, 234, 212, 0.14), transparent 70%),
      var(--white);
  }

  .page-header__inner {
    position: relative;
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: center;
  }

  @media (min-width: 64em) {
    .page-header--photo .page-header__inner {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: clamp(3rem, 5vw, 5rem);
    }
  }

  .page-header__text,
  .page-header__card {
    position: relative;
    z-index: 1;
  }

  /* Branded content card in place of a photo (Services, About, Insights) */
  .page-header__card {
    width: 100%;
    max-width: 34rem;
    justify-self: end;
  }

  .page-header:not(.page-header--photo) .page-header__text {
    max-width: 44rem;
    padding-block: clamp(0.5rem, 2vw, 1.5rem);
  }

  .page-header .kicker {
    margin-bottom: 0.75rem;
  }

  .page-header h1 {
    max-width: 20ch;
    font-size: clamp(2.25rem, 1.4rem + 3.4vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .page-header__intro {
    max-width: 40rem;
    margin-top: clamp(1rem, 2vw, 1.5rem);
    color: var(--slate);
  }

  .page-header__text :global(> .button),
  .page-header__text :global(> p:not(.lede):not(.kicker)) {
    margin-top: 1.5rem;
  }

  /* Pale logo stripes: the SAME size and position on every interior page (fixed
     height, anchored to the header's top-right), so they stay put between pages.
     Headers share a minimum height so the visible part matches too. Wide only. */
  .page-header__stripes {
    display: none;
  }

  @media (min-width: 64em) {
    .page-header {
      display: flex;
      align-items: center;
      min-height: 32rem;
    }

    .page-header > .wrap {
      flex: 1;
    }

    .page-header:not(.page-header--photo) .page-header__text {
      max-width: 40rem;
    }
  }

  /* The long lower arm needs room: show the stripes from 75em (1200px) */
  @media (min-width: 75em) {
    /* Same header height on every interior page, so the stripes look identical */
    .page-header {
      min-height: 39rem;
    }

    .page-header__stripes {
      display: block;
    }

    .page-header__stripes :global(.logo-stripes) {
      top: 0;
      right: 0;
      height: 40rem;
      transform: translateX(16%);
    }
  }

  /* Smaller laptops: push further off the edge to keep the arm clear of the text */
  @media (min-width: 75em) and (max-width: 89.99em) {
    .page-header__stripes :global(.logo-stripes) {
      transform: translateX(28%);
    }
  }
</style>
