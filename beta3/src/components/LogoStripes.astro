---
// Beta 3: the logo's chevrons as thick stripes that cut across a whole section and
// pass BEHIND its photo. The point sits near the top edge, so only a sliver (≈6%)
// of the upper arm shows; the long lower arm sweeps down to the bottom edge.
// - "pair": amber + mint, in the mark's order (hero; anchored to the right edge)
// - "soft": one pale mint stripe (secondary sections; anchored to the left)
// On wide screens the SVG is positioned against the section (its media wrapper is
// static); on narrow screens against the photo, so it never sits behind text.
// Arm angle matches the mark (dx 10 : dy 12). Decorative only.
interface Props { variant?: 'pair' | 'soft' }
const { variant = 'pair' } = Astro.props;

const TIP_Y = 60; // of 1000: the visible sliver of the upper arm
const arm = (tip: number, w: number) => {
  const up = TIP_Y / 1.2;
  const down = (1000 - TIP_Y) / 1.2;
  return [
    [tip - up - w, 0], [tip - up, 0], [tip, TIP_Y],
    [tip - down, 1000], [tip - down - w, 1000], [tip - w, TIP_Y],
  ].map(([x, y]) => `${x.toFixed(0)},${y}`).join(' ');
};
// viewBox spans x -440 … 900 so the stripes reach the bottom edge before the left edge
---
<svg class:list={['logo-stripes', `logo-stripes--${variant}`]} viewBox="-440 0 1340 1000" aria-hidden="true" focusable="false">
  {variant === 'pair' ? (
    <>
      <polygon class="ls ls--amber" points={arm(630, 170)} />
      <polygon class="ls ls--mint" points={arm(900, 230)} />
    </>
  ) : (
    <polygon class="ls ls--soft" points={arm(900, 280)} />
  )}
</svg>

<style>
  /* Wide screens: positioned against the content wrapper, extended by the
     section padding (--stripe-pad, set by the section) to reach its edges */
  .logo-stripes {
    position: absolute;
    z-index: 0;
    top: calc(-1 * var(--stripe-pad, 0px));
    max-width: none;
    height: calc(100% + 2 * var(--stripe-pad, 0px));
    width: auto;
    aspect-ratio: 1340 / 1000;
    pointer-events: none;
  }

  /* Pushed partly off the right edge: the amber point sits just beside the photo,
     the mint tip runs off the page, and the long arms stay clear of the text */
  .logo-stripes--pair {
    right: 0;
    transform: translateX(18%);
  }

  @media (min-width: 64em) and (max-width: 79.99em) {
    .logo-stripes--pair {
      transform: translateX(26%);
    }
  }

  /* Point just beyond the photo's right edge: the photo fills the left half of a
     two-column grid, so its right edge is 50% + half the gap from the right.
     The section sets --stripe-gap to its grid gap. */
  .logo-stripes--soft {
    right: calc(50% + var(--stripe-gap, 3rem) / 2 - 1.25rem);
  }

  /* Narrow screens: sit behind the photo only */
  @media (max-width: 63.99em) {
    .logo-stripes {
      top: -1.25rem;
      bottom: -2.5rem;
      height: calc(100% + 3.75rem);
    }

    .logo-stripes--pair {
      right: calc(-1 * var(--gutter));
      transform: none;
    }

    .logo-stripes--soft {
      left: auto;
      right: calc(-1 * var(--gutter));
      /* keep it to the photo area: nothing below, where the text starts */
      top: -1.25rem;
      bottom: 0;
      height: calc(100% + 1.25rem);
    }
  }

  .ls--amber { fill: var(--amber); }
  .ls--mint { fill: var(--mint); }
  .ls--soft { fill: #c9eee6; }

  @media (forced-colors: active) {
    .logo-stripes {
      display: none;
    }
  }
</style>
