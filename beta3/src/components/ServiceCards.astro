---
// Beta 3: white service cards (whole card clickable). `line` picks the copy:
// the Home card line or the Services page "For when…" line.
import ServiceIcon from './ServiceIcon.astro';
import { services } from '../data/services';
import { url } from '../lib/paths';
import { brandify } from '../lib/brand';
interface Props { line?: 'homeLine' | 'forWhen'; exclude?: string; columns?: 2 | 3 | 4; useExplore?: boolean }
const { line = 'homeLine', exclude, columns = 4, useExplore = false } = Astro.props;
const list = services.filter((s) => s.slug !== exclude);
---
<ul class:list={['service-cards', `service-cards--${columns}`]}>
  {list.map((s) => (
    <li class="service-card">
      <span class="service-card__icon"><ServiceIcon name={s.icon} /></span>
      <h3><a href={url(`services/${s.slug}/`)} class="service-card__link" set:html={brandify(s.name)} /></h3>
      <p>{s[line]}</p>
      <span class="service-card__more" aria-hidden="true">{useExplore ? s.explore : 'Explore'} <span class="arrow">→</span></span>
    </li>
  ))}
</ul>

<style>
  .service-cards {
    display: grid;
    gap: 1.25rem;
    margin: clamp(1.75rem, 3.5vw, 2.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40em) {
    .service-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72em) {
    .service-cards--4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .service-cards--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    border: 1px solid #e3e8e6;
    border-radius: 1.25rem;
    background: var(--white);
    box-shadow: 0 1px 2px rgba(14, 42, 47, 0.04);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .service-card:hover,
  .service-card:focus-within {
    transform: translateY(-4px);
    border-color: #b7dcd5;
    box-shadow: 0 24px 44px -28px rgba(14, 42, 47, 0.4);
  }

  .service-card__icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: 0.5rem;
    border-radius: 1rem;
    background: #dcf3ee;
  }

  .service-card__icon :global(.service-icon) {
    width: 2.25rem;
    height: 2.25rem;
  }

  .service-card h3 {
    font-size: 1.375rem;
  }

  .service-card__link {
    color: var(--ink);
    text-decoration: none;
  }

  .service-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 1.25rem;
  }

  .service-card__link:focus-visible {
    outline: none;
  }

  .service-card__link:focus-visible::after {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  .service-card:hover .service-card__link {
    text-decoration: underline;
  }

  .service-card p {
    flex: 1;
    color: var(--slate);
  }

  .service-card__more {
    color: var(--teal-dark);
    font-weight: 600;
  }

  .service-card__more .arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .service-card:hover .service-card__more .arrow {
    transform: translateX(4px);
  }
</style>
