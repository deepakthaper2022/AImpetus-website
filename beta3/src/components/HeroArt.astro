---
// "Engine room" hero artwork: a gauge/turbine of rings around the brand chevrons.
// Decorative only. Built from the mark geometry in brief/brand.md.
---
<svg class="hero-art" viewBox="0 0 560 560" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="ha-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="#5EEAD4" stop-opacity="0.30" />
      <stop offset="0.45" stop-color="#14B8A6" stop-opacity="0.10" />
      <stop offset="1" stop-color="#0E2A2F" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="ha-fade" cx="50%" cy="50%" r="50%">
      <stop offset="0.35" stop-color="#fff" stop-opacity="1" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
    <mask id="ha-mask">
      <rect width="560" height="560" fill="url(#ha-fade)" />
    </mask>
    <pattern id="ha-dots" width="20" height="20" patternUnits="userSpaceOnUse">
      <circle cx="10" cy="10" r="1.2" fill="#3B6168" />
    </pattern>
    <linearGradient id="ha-amber" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#FCD34D" />
      <stop offset="0.5" stop-color="#F59E0B" />
      <stop offset="1" stop-color="#D97706" />
    </linearGradient>
    <linearGradient id="ha-mint" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#CCFBF1" />
      <stop offset="0.45" stop-color="#5EEAD4" />
      <stop offset="1" stop-color="#14B8A6" />
    </linearGradient>
  </defs>

  <!-- Dotted field and glow -->
  <rect width="560" height="560" fill="url(#ha-dots)" mask="url(#ha-mask)" />
  <circle cx="280" cy="280" r="270" fill="url(#ha-glow)" />

  <!-- Outer ring with gauge ticks (slowly turns) -->
  <g class="hero-art__spin">
    <circle cx="280" cy="280" r="252" fill="none" stroke="#2A4A50" stroke-width="1" />
    <circle cx="280" cy="280" r="236" fill="none" stroke="#3B6168" stroke-width="10" stroke-dasharray="1.5 13.3" />
    <circle cx="280" cy="532" r="5" fill="#F59E0B" />
    <circle cx="28" cy="280" r="4" fill="#5EEAD4" />
    <circle cx="458" cy="102" r="3.5" fill="#5EEAD4" />
  </g>

  <!-- Middle ring with a highlighted "reading" arc -->
  <circle cx="280" cy="280" r="196" fill="none" stroke="#2A4A50" stroke-width="1" />
  <path d="M 110.3 182 A 196 196 0 0 1 449.7 182" fill="none" stroke="#5EEAD4" stroke-width="3" stroke-linecap="round" opacity="0.9" />
  <circle cx="449.7" cy="182" r="6" fill="#5EEAD4" />

  <!-- Inner ring -->
  <circle cx="280" cy="280" r="150" fill="#0B2328" fill-opacity="0.55" stroke="#5EEAD4" stroke-opacity="0.35" stroke-width="1.5" />

  <!-- Chevrons: motion trail, then the mark -->
  <g transform="translate(280 280) scale(6.4) translate(-24.5 -24)">
    <g fill="none" stroke="#5EEAD4" stroke-width="0.25" stroke-linejoin="round">
      <polygon points="-3,12 6,12 16,24 6,36 -3,36 7,24" opacity="0.18" />
      <polygon points="3,12 12,12 22,24 12,36 3,36 13,24" opacity="0.35" />
    </g>
    <polygon points="9,12 18,12 28,24 18,36 9,36 19,24" fill="url(#ha-amber)" />
    <polygon points="22,12 30,12 40,24 30,36 22,36 32,24" fill="url(#ha-mint)" />
  </g>
</svg>

<style>
  .hero-art {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .hero-art__spin {
    transform-origin: 280px 280px;
    animation: hero-art-spin 120s linear infinite;
  }

  @keyframes hero-art-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-art__spin {
      animation: none;
    }
  }
</style>
