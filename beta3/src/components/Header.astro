---
// Beta 3 header: white bar, primary logo, plain links and a rounded teal button.
// On small screens the menu opens as a full-screen light overlay (focus is kept
// inside while open; Escape closes it).
import { mainNav, BETA_NUMBER } from '../lib/site';
import { url, isCurrent } from '../lib/paths';

const currentPath = Astro.url.pathname;
---
<header class="site-header" data-header>
  <p class="beta-banner">Beta {BETA_NUMBER} preview – not the live AImpetus website.</p>

  <div class="masthead-bar">
    <div class="masthead wrap">
      <a href={url('')} class="logo-link">
        <img src={url('images/aimpetus-logo-primary.svg')} alt="AImpetus – home" width="519" height="96" class="logo" />
      </a>

      <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
        <span class="menu-toggle__icon" aria-hidden="true"></span>
        <span class="menu-toggle__text">Menu</span>
      </button>

      <nav id="site-nav" class="site-nav" aria-label="Main" data-menu>
        <ul class="site-nav__list">
          {mainNav.map((item) => (
            <li>
              <a href={url(item.path)} aria-current={isCurrent(currentPath, item.path) ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
        <a href={url('contact/')} class="site-nav__cta">Book a conversation</a>
      </nav>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = header?.querySelector<HTMLElement>('[data-menu]');

  if (header && toggle && menu) {
    header.classList.add('has-js');
    const small = window.matchMedia('(max-width: 63.99em)');

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      header.classList.toggle('menu-open', open);
      document.documentElement.classList.toggle('menu-lock', open);
      if (open) menu.querySelector<HTMLElement>('a')?.focus();
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      if (event.key === 'Escape') {
        setOpen(false);
        toggle.focus();
        return;
      }
      // Keep focus within the overlay (menu links + the close button)
      if (event.key === 'Tab' && small.matches) {
        const items = [toggle, ...menu.querySelectorAll<HTMLElement>('a')];
        const first = items[0];
        const last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    small.addEventListener('change', (e) => {
      if (!e.matches) setOpen(false);
    });
  }
</script>

<style>
  .beta-banner {
    position: relative;
    z-index: 31;
    margin: 0;
    padding: 0.5rem var(--gutter);
    background: var(--amber);
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.4;
    text-align: center;
  }

  .masthead-bar {
    position: relative;
    z-index: 30;
    background: var(--white);
    border-bottom: 1px solid #e3e8e6;
  }

  .masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 1.125rem;
  }

  .logo-link {
    position: relative;
    z-index: 32;
    display: inline-block;
    padding-block: 0.25rem;
  }

  .logo {
    width: clamp(9.5rem, 28vw, 11.5rem);
    height: auto;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1rem 2rem;
  }

  .site-nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__list a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  .site-nav__list a:hover {
    color: var(--teal-dark);
    border-bottom-color: currentColor;
  }

  .site-nav__list a[aria-current='page'] {
    color: var(--teal-dark);
    border-bottom-color: var(--teal);
  }

  .site-nav__cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1.375rem;
    border-radius: 2rem;
    background: var(--teal);
    color: var(--white);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .site-nav__cta:hover {
    background: var(--teal-dark);
    color: var(--white);
    text-decoration: underline;
  }

  .masthead :focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }

  .menu-toggle {
    position: relative;
    z-index: 32;
    display: none;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    padding: 0.5rem 1.125rem;
    border: 2px solid var(--ink);
    border-radius: 2rem;
    background: var(--white);
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .menu-toggle__icon,
  .menu-toggle__icon::before,
  .menu-toggle__icon::after {
    display: block;
    width: 1.125rem;
    height: 2px;
    background: currentColor;
  }

  .menu-toggle__icon {
    position: relative;
  }

  .menu-toggle__icon::before,
  .menu-toggle__icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .menu-toggle__icon::before {
    top: -6px;
  }

  .menu-toggle__icon::after {
    top: 6px;
  }

  .menu-open .menu-toggle__icon {
    background: transparent;
  }

  .menu-open .menu-toggle__icon::before {
    top: 0;
    transform: rotate(45deg);
  }

  .menu-open .menu-toggle__icon::after {
    top: 0;
    transform: rotate(-45deg);
  }

  @media (max-width: 63.99em) {
    .site-nav {
      flex-basis: 100%;
      flex-direction: column;
      align-items: flex-start;
    }

    .site-nav__list {
      flex-direction: column;
    }

    @media (scripting: enabled) {
      .menu-toggle {
        display: inline-flex;
      }

      .site-nav {
        position: fixed;
        inset: 0;
        z-index: 31;
        display: none;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        gap: 2rem;
        padding: 7rem var(--gutter) 3rem;
        overflow-y: auto;
        background: linear-gradient(160deg, var(--white) 55%, #e6f4f1 100%);
      }

      .menu-open .site-nav {
        display: flex;
      }

      .site-nav__list {
        gap: 0.25rem;
      }

      .site-nav__list a {
        font-family: var(--font-heading);
        font-size: clamp(1.75rem, 1.2rem + 3vw, 2.5rem);
        font-weight: 700;
      }
    }
  }

  :global(html.menu-lock) {
    overflow: hidden;
  }

  @media (forced-colors: active) {
    .site-nav__list a[aria-current='page'] {
      border-bottom-color: CanvasText;
    }

    .site-nav__cta {
      border: 2px solid ButtonText;
    }

    .menu-toggle__icon,
    .menu-toggle__icon::before,
    .menu-toggle__icon::after {
      background: CanvasText;
    }

    .menu-open .menu-toggle__icon {
      background: transparent;
    }
  }
</style>
