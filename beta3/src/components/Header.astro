---
// Beta 3 header: dark bar with a mint baseline. On small screens the menu opens as a
// full-screen overlay (focus is kept inside while open; Escape closes it).
import { mainNav, BETA_NUMBER } from '../lib/site';
import { url, isCurrent } from '../lib/paths';

const currentPath = Astro.url.pathname;
---
<header class="site-header" data-header>
  <p class="beta-banner">Beta {BETA_NUMBER} preview – not the live AImpetus website.</p>

  <div class="masthead-bar">
    <div class="masthead wrap">
      <a href={url('')} class="logo-link">
        <img src={url('images/aimpetus-logo-reversed.svg')} alt="AImpetus – home" width="519" height="96" class="logo" />
      </a>

      <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
        <span class="menu-toggle__icon" aria-hidden="true"></span>
        <span class="menu-toggle__text">Menu</span>
      </button>

      <nav id="site-nav" class="site-nav" aria-label="Main" data-menu>
        <ol class="site-nav__list">
          {mainNav.map((item, i) => (
            <li>
              <a href={url(item.path)} aria-current={isCurrent(currentPath, item.path) ? 'page' : undefined}>
                <span class="site-nav__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span>{item.label}</span>
              </a>
            </li>
          ))}
        </ol>
        <a href={url('contact/')} class="site-nav__cta">Book a conversation</a>
      </nav>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = header?.querySelector<HTMLElement>('[data-menu]');

  if (header && toggle && menu) {
    header.classList.add('has-js');
    const small = window.matchMedia('(max-width: 63.99em)');

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      header.classList.toggle('menu-open', open);
      document.documentElement.classList.toggle('menu-lock', open);
      if (open) menu.querySelector<HTMLElement>('a')?.focus();
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      if (event.key === 'Escape') {
        setOpen(false);
        toggle.focus();
        return;
      }
      // Keep focus within the overlay (menu links + the close button)
      if (event.key === 'Tab' && small.matches) {
        const items = [toggle, ...menu.querySelectorAll<HTMLElement>('a')];
        const first = items[0];
        const last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    small.addEventListener('change', (e) => {
      if (!e.matches) setOpen(false);
    });
  }
</script>

<style>
  .beta-banner {
    position: relative;
    z-index: 31;
    margin: 0;
    padding: 0.5rem var(--gutter);
    background: var(--amber);
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.4;
    text-align: center;
  }

  .masthead-bar {
    position: relative;
    z-index: 30;
    background: var(--ink-deeper);
    border-bottom: 2px solid var(--mint);
  }

  .masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 1rem;
  }

  .logo-link {
    position: relative;
    z-index: 32;
    display: inline-block;
    padding-block: 0.25rem;
  }

  .logo {
    width: clamp(9.5rem, 28vw, 11.5rem);
    height: auto;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  .site-nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__list a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding-top: 0.7rem;
    color: var(--paper);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  .site-nav__num {
    color: var(--mint);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }

  .site-nav__list a:hover {
    color: var(--mint);
    border-bottom-color: currentColor;
  }

  .site-nav__list a[aria-current='page'] {
    color: var(--mint);
    border-bottom-color: var(--mint);
  }

  .site-nav__cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1.125rem;
    border: 2px solid var(--mint);
    border-radius: 0.25rem;
    color: var(--mint);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .site-nav__cta:hover {
    background: var(--mint);
    color: var(--ink);
  }

  .menu-toggle {
    position: relative;
    z-index: 32;
    display: none;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 2px solid var(--mint);
    border-radius: 0.25rem;
    background: transparent;
    color: var(--mint);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .menu-toggle__icon,
  .menu-toggle__icon::before,
  .menu-toggle__icon::after {
    display: block;
    width: 1.125rem;
    height: 2px;
    background: currentColor;
  }

  .menu-toggle__icon {
    position: relative;
  }

  .menu-toggle__icon::before,
  .menu-toggle__icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .menu-toggle__icon::before {
    top: -6px;
  }

  .menu-toggle__icon::after {
    top: 6px;
  }

  .menu-open .menu-toggle__icon {
    background: transparent;
  }

  .menu-open .menu-toggle__icon::before {
    top: 0;
    transform: rotate(45deg);
  }

  .menu-open .menu-toggle__icon::after {
    top: 0;
    transform: rotate(-45deg);
  }

  @media (max-width: 63.99em) {
    /* Without JS (no scripting) the nav simply shows below the logo */
    .site-nav {
      flex-basis: 100%;
      flex-direction: column;
      align-items: flex-start;
    }

    .site-nav__list {
      flex-direction: column;
    }

    @media (scripting: enabled) {
      .menu-toggle {
        display: inline-flex;
      }

      /* Full-screen overlay */
      .site-nav {
        position: fixed;
        inset: 0;
        z-index: 31;
        display: none;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        gap: 2rem;
        padding: 7rem var(--gutter) 3rem;
        overflow-y: auto;
        background:
          linear-gradient(to right, rgba(94, 234, 212, 0.06) 1px, transparent 1px) 0 0 / 48px 48px,
          linear-gradient(to bottom, rgba(94, 234, 212, 0.06) 1px, transparent 1px) 0 0 / 48px 48px,
          var(--ink-deeper);
      }

      .menu-open .site-nav {
        display: flex;
      }

      .site-nav__list {
        gap: 0.25rem;
      }

      .site-nav__list a {
        font-family: var(--font-heading);
        font-size: clamp(1.75rem, 1.2rem + 3vw, 2.5rem);
        font-weight: 700;
        gap: 0.75rem;
      }

      .site-nav__num {
        font-size: 0.9375rem;
      }
    }
  }

  :global(html.menu-lock) {
    overflow: hidden;
  }

  @media (forced-colors: active) {
    .site-nav__list a[aria-current='page'] {
      border-bottom-color: CanvasText;
    }

    .menu-toggle__icon,
    .menu-toggle__icon::before,
    .menu-toggle__icon::after {
      background: CanvasText;
    }

    .menu-open .menu-toggle__icon {
      background: transparent;
    }
  }
</style>
