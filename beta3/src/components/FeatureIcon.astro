---
// Line icons for feature cards (48 grid, 2px strokes). Decorative only.
export type FeatureIconName =
  | 'senior' | 'health' | 'layers' | 'commercial' | 'partner'
  | 'honest' | 'standards' | 'knowledge' | 'value'
  | 'target' | 'organisation' | 'foundation' | 'evidence' | 'public';
interface Props { name: FeatureIconName }
const { name } = Astro.props;
---
<svg class="feature-icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  {name === 'senior' && (<>
    <circle class="fi-l" cx="17" cy="16" r="6" /><path class="fi-l" d="M6 38c0-7 5-11 11-11s11 4 11 11" />
    <circle class="fi-a" cx="33" cy="14" r="5" /><path class="fi-a" d="M30 25c6-1 12 3 12 11" />
  </>)}
  {name === 'health' && (<>
    <path class="fi-l" d="M24 40S7 30 7 18a9 9 0 0 1 17-4 9 9 0 0 1 17 4c0 12-17 22-17 22z" />
    <path class="fi-a" d="M10 24h8l3-6 5 11 3-5h9" />
  </>)}
  {name === 'layers' && (<>
    <path class="fi-l" d="M24 8 42 17 24 26 6 17z" /><path class="fi-l" d="m6 25 18 9 18-9" /><path class="fi-l" d="m6 33 18 9 18-9" />
    <path class="fi-a" d="m20 14 4 3 4-3" />
  </>)}
  {name === 'commercial' && (<>
    <rect class="fi-l" x="6" y="14" width="36" height="26" rx="4" /><path class="fi-l" d="M17 14v-4a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v4" />
    <path class="fi-a" d="M14 32l6-6 5 4 9-9" /><path class="fi-a" d="M29 21h5v5" />
  </>)}
  {name === 'partner' && (<>
    <circle class="fi-l" cx="18" cy="24" r="11" /><circle class="fi-a" cx="30" cy="24" r="11" />
  </>)}
  {name === 'honest' && (<>
    <path class="fi-l" d="M8 10h32a2 2 0 0 1 2 2v20a2 2 0 0 1-2 2H20l-9 7v-7H8a2 2 0 0 1-2-2V12a2 2 0 0 1 2-2z" />
    <path class="fi-a" d="m17 22 5 5 9-10" />
  </>)}
  {name === 'standards' && (<>
    <path class="fi-l" d="M24 6 39 11v11c0 10-7 17-15 20C16 39 9 32 9 22V11z" />
    <path class="fi-a" d="m17 23 5 5 9-10" />
  </>)}
  {name === 'knowledge' && (<>
    <path class="fi-l" d="M24 14c-4-4-10-5-17-4v26c7-1 13 0 17 4 4-4 10-5 17-4V10c-7-1-13 0-17 4z" /><path class="fi-l" d="M24 14v26" />
    <path class="fi-a" d="M12 18h6M12 24h6M30 18h6M30 24h6" />
  </>)}
  {name === 'value' && (<>
    <path class="fi-l" d="M24 8v32M12 40h24" /><path class="fi-l" d="M8 14h32" />
    <path class="fi-a" d="m12 14-6 12a6 6 0 0 0 12 0zM36 14l-6 12a6 6 0 0 0 12 0z" />
  </>)}
  {name === 'target' && (<>
    <circle class="fi-l" cx="24" cy="24" r="17" /><circle class="fi-l" cx="24" cy="24" r="10" />
    <circle class="fi-a" cx="24" cy="24" r="3" /><path class="fi-a" d="M24 24 38 10M33 10h5v5" />
  </>)}
  {name === 'organisation' && (<>
    <rect class="fi-l" x="17" y="6" width="14" height="10" rx="2" /><rect class="fi-l" x="5" y="32" width="12" height="10" rx="2" />
    <rect class="fi-l" x="31" y="32" width="12" height="10" rx="2" /><path class="fi-a" d="M24 16v8M11 32v-8h26v8M24 24v8" />
  </>)}
  {name === 'foundation' && (<>
    <path class="fi-l" d="M8 40h32M12 40V24M24 40V24M36 40V24M6 24h36L24 10z" />
    <path class="fi-a" d="M6 44h36" />
  </>)}
  {name === 'evidence' && (<>
    <circle class="fi-l" cx="21" cy="21" r="13" /><path class="fi-l" d="m31 31 10 10" />
    <path class="fi-a" d="M15 25v-3M21 25v-8M27 25v-5" />
  </>)}
  {name === 'public' && (<>
    <path class="fi-l" d="M6 18 24 8l18 10zM8 40h32M10 22v14M18 22v14M30 22v14M38 22v14" />
    <circle class="fi-a" cx="24" cy="28" r="4" />
  </>)}
</svg>

<style>
  .feature-icon {
    width: 1.75rem;
    height: 1.75rem;
  }

  .fi-l {
    stroke: var(--icon-line, var(--mint));
  }

  .fi-a {
    stroke: var(--amber);
  }

  @media (forced-colors: active) {
    .fi-l,
    .fi-a {
      stroke: CanvasText;
    }
  }
</style>
