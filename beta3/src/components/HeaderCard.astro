---
// Beta 3: white card with a soft shadow, matching the photo frames.
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---
<div class:list={['header-card', className]}><slot /></div>

<style>
  .header-card {
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid #e3e8e6;
    border-radius: 1.5rem;
    background: var(--white);
    box-shadow: 0 28px 56px -30px rgba(14, 42, 47, 0.45);
  }
</style>
