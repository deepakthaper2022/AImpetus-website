---
// Beta 2 Services overview – copy from brief/website-content.pdf ("Services overview page").
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import IndexHead from '../../components/IndexHead.astro';
import ProblemOutcome from '../../components/ProblemOutcome.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import { services } from '../../data/services';
import { url } from '../../lib/paths';
import { brandify } from '../../lib/brand';

const toc = [
  { id: 'fit-heading', label: 'How our services fit together' },
  ...services.map((s) => ({ id: `service-${s.slug}`, label: s.name })),
];
---
<BaseLayout
  title="Services | AImpetus"
  description="Data and platforms, AI to benefit, digital transformation and delivery assurance for public-sector and other organisations."
>
  <PageHeader
    crumbLabel="Services"
    title="Services built around the outcome, not the technology"
    intro="We help public-sector and other organisations improve services with data, digital and AI. Each service can stand alone or work with the others, and each starts with the problem you need to solve."
    toc={toc}
  />

  <section class="section on-paper wm" aria-labelledby="fit-heading">
    <div class="wrap">
      <IndexHead
        id="fit-heading"
        index="01"
        text="How our services fit together"
        intro="Good data makes digital change possible. Good digital services give AI somewhere useful to work. Strong delivery assurance keeps all of it on track."
      />

      <!-- Decorative: the services as a stack, with assurance around it (explained by the text above) -->
      <div class="stack" aria-hidden="true">
        <div class="stack__frame">
          <span class="stack__frame-label" set:html={brandify(services[3].name)} />
          <div class="stack__layer stack__layer--ai"><span set:html={brandify(services[1].name)} /></div>
          <div class="stack__layer stack__layer--digital"><span>{services[2].name}</span></div>
          <div class="stack__layer stack__layer--data"><span>{services[0].name}</span></div>
        </div>
      </div>

      <div class="cards">
        <ProblemOutcome explore />
      </div>
    </div>
  </section>

  <CtaPanel
    heading="Not sure where to start?"
    text="Most conversations begin with a problem, not a service. Tell us yours."
    button="Book a 30-minute conversation"
    href={url('contact/')}
  />
</BaseLayout>

<style>
  .stack {
    max-width: 44rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .stack__frame {
    position: relative;
    display: grid;
    gap: 0.5rem;
    padding: 2.75rem 1rem 1rem;
    border: 2px dashed var(--teal);
    border-radius: var(--radius-card);
    background: var(--white);
  }

  .stack__frame-label {
    position: absolute;
    top: 0.75rem;
    left: 1rem;
    color: var(--teal-dark);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .stack__layer {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    padding-inline: 1.25rem;
    border-radius: 0.25rem;
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .stack__layer--ai {
    margin-inline: 18%;
    background: var(--mint);
    color: var(--ink);
  }

  .stack__layer--digital {
    margin-inline: 8%;
    background: var(--teal);
    color: var(--white);
  }

  .stack__layer--data {
    background: var(--ink);
    color: var(--white);
  }

  .cards :global(.po) {
    scroll-margin-top: 1rem;
  }
</style>
