---
// Beta 2 Services overview – copy from brief/website-content.pdf ("Services overview page").
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import IndexHead from '../../components/IndexHead.astro';
import ProblemOutcome from '../../components/ProblemOutcome.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import { services } from '../../data/services';
import { url } from '../../lib/paths';
import { brandify } from '../../lib/brand';

const toc = [
  { id: 'fit-heading', label: 'How our services fit together' },
  ...services.map((s) => ({ id: `service-${s.slug}`, label: s.name })),
];
---
<BaseLayout
  title="Services | AImpetus"
  description="Data and platforms, AI to benefit, digital transformation and delivery assurance for public-sector and other organisations."
>
  <PageHeader
    crumbLabel="Services"
    title="Services built around the outcome, not the technology"
    intro="We help public-sector and other organisations improve services with data, digital and AI. Each service can stand alone or work with the others, and each starts with the problem you need to solve."
    toc={toc}
  />

  <section class="section on-paper" aria-labelledby="fit-heading">
    <div class="wrap">
      <IndexHead
        id="fit-heading"
        index="01"
        text="How our services fit together"
        intro="Good data makes digital change possible. Good digital services give AI somewhere useful to work. Strong delivery assurance keeps all of it on track."
      />

      <!-- Decorative (the text above says the same): each service as the lower arm of a
           logo chevron, cropped at the top, moving forward on a "Delivery assurance" base -->
      <div class="fit" aria-hidden="true">
        <svg class="fit__wide" viewBox="0 0 1200 560" preserveAspectRatio="xMidYMid slice" focusable="false">
          <defs>
            <pattern id="fit-grid" width="40" height="40" patternUnits="userSpaceOnUse">
              <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#e1e7e4" stroke-width="1" />
            </pattern>
          </defs>
          <rect width="1200" height="560" fill="url(#fit-grid)" />
          <polygon class="fit__stripe fit__stripe--ink" points="313.3,0.0 513.3,0.0 560.0,56.0 231.7,450.0 31.7,450.0 360.0,56.0" />
          <text class="fit__label fit__label--ink" transform="translate(161.7 414.0) rotate(-50.2)" dominant-baseline="middle">{services[0].name}</text>
          <polygon class="fit__stripe fit__stripe--teal" points="653.3,0.0 853.3,0.0 900.0,56.0 571.7,450.0 371.7,450.0 700.0,56.0" />
          <text class="fit__label fit__label--teal" transform="translate(501.7 414.0) rotate(-50.2)" dominant-baseline="middle">{services[2].name}</text>
          <polygon class="fit__stripe fit__stripe--mint" points="993.3,0.0 1193.3,0.0 1240.0,56.0 911.7,450.0 711.7,450.0 1040.0,56.0" />
          <text class="fit__label fit__label--mint" transform="translate(841.7 414.0) rotate(-50.2)" dominant-baseline="middle"><tspan>A</tspan><tspan class="fit__i">I</tspan><tspan> to benefit</tspan></text>
          <!-- The base: delivery assurance keeps it all on track -->
          <polygon class="fit__track" points="0,460 1156,460 1200,510 1156,560 0,560" />
          <text class="fit__track-label" x="40" y="510" dominant-baseline="middle">{services[3].name}</text>
        </svg>

        <ol class="fit__narrow">
          <li class="fit__chip fit__chip--ink"><span>{services[0].name}</span></li>
          <li class="fit__chip fit__chip--teal"><span>{services[2].name}</span></li>
          <li class="fit__chip fit__chip--mint"><span set:html={brandify(services[1].name)} /></li>
          <li class="fit__chip fit__chip--track"><span>{services[3].name}</span></li>
        </ol>
      </div>

      <div class="cards">
        <ProblemOutcome explore />
      </div>
    </div>
  </section>

  <CtaPanel
    heading="Not sure where to start?"
    text="Most conversations begin with a problem, not a service. Tell us yours."
    button="Book a 30-minute conversation"
    href={url('contact/')}
  />
</BaseLayout>

<style>
  .fit {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    border: 1px solid var(--grid-line);
    border-radius: var(--radius-card);
    background: var(--white);
    overflow: hidden;
  }

  .fit__wide {
    display: none;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 560;
  }

  .fit__stripe--ink { fill: var(--ink); }
  .fit__stripe--teal { fill: var(--teal); }
  .fit__stripe--mint { fill: var(--mint); }

  .fit__label,
  .fit__track-label {
    font-family: var(--font-heading);
    font-size: 40px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .fit__label--ink,
  .fit__label--teal { fill: var(--white); }
  .fit__label--mint { fill: var(--ink); }

  .fit__i {
    font-family: 'AImpetus I', 'Inter', sans-serif;
  }

  .fit__track { fill: var(--amber); }
  .fit__track-label { fill: var(--ink); }

  /* Narrow screens: thick slanted strips with large type */
  .fit__narrow {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fit__chip {
    display: flex;
    align-items: center;
    min-height: 4.5rem;
    margin-top: -0.75rem;
    padding: 1.25rem 1.5rem 1.25rem 1.25rem;
    clip-path: polygon(0 0.75rem, 100% 0, 100% calc(100% - 0.75rem), 0 100%);
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .fit__chip:first-child {
    margin-top: 0;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 0.75rem), 0 100%);
  }

  .fit__chip--ink { background: var(--ink); color: var(--white); }
  .fit__chip--teal { background: var(--teal); color: var(--white); }
  .fit__chip--mint { background: var(--mint); color: var(--ink); }
  .fit__chip--track {
    background: var(--amber);
    color: var(--ink);
    clip-path: polygon(0 0.75rem, 100% 0, 100% 100%, 0 100%);
  }

  @media (min-width: 40em) {
    .fit__wide {
      display: block;
    }

    .fit__narrow {
      display: none;
    }
  }

  .cards :global(.po) {
    scroll-margin-top: 1rem;
  }
</style>
