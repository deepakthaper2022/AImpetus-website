---
// Beta 2 Services overview – copy from brief/website-content.pdf ("Services overview page").
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import IndexHead from '../../components/IndexHead.astro';
import ProblemOutcome from '../../components/ProblemOutcome.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import { services } from '../../data/services';
import { url } from '../../lib/paths';
import { brandify } from '../../lib/brand';

const toc = [
  { id: 'fit-heading', label: 'How our services fit together' },
  ...services.map((s) => ({ id: `service-${s.slug}`, label: s.name })),
];
---
<BaseLayout
  title="Services | AImpetus"
  description="Data and platforms, AI to benefit, digital transformation and delivery assurance for public-sector and other organisations."
>
  <PageHeader
    crumbLabel="Services"
    title="Services built around the outcome, not the technology"
    intro="We help public-sector and other organisations improve services with data, digital and AI. Each service can stand alone or work with the others, and each starts with the problem you need to solve."
    toc={toc}
  />

  <section class="section on-paper" aria-labelledby="fit-heading">
    <div class="wrap">
      <IndexHead
        id="fit-heading"
        index="01"
        text="How our services fit together"
        intro="Good data makes digital change possible. Good digital services give AI somewhere useful to work. Strong delivery assurance keeps all of it on track."
      />

      <!-- Decorative (the text above says the same): the services as logo-style
           chevron strips moving forward, on a "Delivery assurance" track -->
      <div class="fit" aria-hidden="true">
        <svg class="fit__wide" viewBox="0 0 900 400" focusable="false">
          {[
            { x: 0, cls: 'ink', label: services[0].name },
            { x: 290, cls: 'teal', label: services[2].name },
            { x: 580, cls: 'mint', label: services[1].name, ai: true },
          ].map((c) => (
            <g>
              <polygon class={`fit__strip fit__strip--${c.cls}`} points={`${c.x},20 ${c.x + 100},20 ${c.x + 280},180 ${c.x + 100},340 ${c.x},340 ${c.x + 180},180`} />
              <text
                class={`fit__label fit__label--${c.cls}`}
                transform={`translate(${c.x + 58} 58) rotate(41.6)`}
              >
                {c.ai ? <><tspan>A</tspan><tspan class="fit__i">I</tspan><tspan> to benefit</tspan></> : c.label}
              </text>
            </g>
          ))}
          <!-- The track -->
          <polygon class="fit__track" points="0,362 866,362 896,381 866,400 0,400" />
          <text class="fit__track-label" x="24" y="388">{services[3].name}</text>
        </svg>

        <ol class="fit__narrow">
          <li class="fit__chip fit__chip--ink">{services[0].name}</li>
          <li class="fit__chip fit__chip--teal">{services[2].name}</li>
          <li class="fit__chip fit__chip--mint"><span set:html={brandify(services[1].name)} /></li>
          <li class="fit__chip fit__chip--track">{services[3].name}</li>
        </ol>
      </div>

      <div class="cards">
        <ProblemOutcome explore />
      </div>
    </div>
  </section>

  <CtaPanel
    heading="Not sure where to start?"
    text="Most conversations begin with a problem, not a service. Tell us yours."
    button="Book a 30-minute conversation"
    href={url('contact/')}
  />
</BaseLayout>

<style>
  .fit {
    max-width: 52rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--grid-line);
    border-radius: var(--radius-card);
    background: var(--white);
  }

  .fit__wide {
    display: none;
    width: 100%;
    height: auto;
  }

  .fit__strip--ink { fill: var(--ink); }
  .fit__strip--teal { fill: var(--teal); }
  .fit__strip--mint { fill: var(--mint); }

  .fit__label {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .fit__label--ink,
  .fit__label--teal { fill: var(--white); }
  .fit__label--mint { fill: var(--ink); }

  .fit__i {
    font-family: 'AImpetus I', 'Inter', sans-serif;
  }

  .fit__track { fill: var(--amber); }

  .fit__track-label {
    fill: var(--ink);
    font-family: var(--font-heading);
    font-size: 19px;
    font-weight: 700;
  }

  /* Narrow screens: the same idea as stacked arrow strips */
  .fit__narrow {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fit__chip {
    display: flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.5rem 2.25rem 0.5rem 1rem;
    clip-path: polygon(0 0, calc(100% - 1.25rem) 0, 100% 50%, calc(100% - 1.25rem) 100%, 0 100%, 1.25rem 50%);
    padding-left: 2rem;
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .fit__chip--ink { background: var(--ink); color: var(--white); }
  .fit__chip--teal { background: var(--teal); color: var(--white); margin-left: 0.75rem; }
  .fit__chip--mint { background: var(--mint); color: var(--ink); margin-left: 1.5rem; }

  .fit__chip--track {
    margin-top: 0.25rem;
    padding-left: 1rem;
    clip-path: polygon(0 0, calc(100% - 1.25rem) 0, 100% 50%, calc(100% - 1.25rem) 100%, 0 100%);
    background: var(--amber);
    color: var(--ink);
  }

  @media (min-width: 40em) {
    .fit__wide {
      display: block;
    }

    .fit__narrow {
      display: none;
    }
  }

  .cards :global(.po) {
    scroll-margin-top: 1rem;
  }
</style>
