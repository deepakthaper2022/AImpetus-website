---
// Beta 2 Insights – copy from brief/website-content.pdf ("Insights page"). The
// "coming soon" line is builder-drafted copy (brief/copy-changes.md).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Placeholder from '../components/Placeholder.astro';
import { COMPANY_LINKEDIN } from '../lib/site';
---
<BaseLayout
  title="Insights | AImpetus"
  description="Practical thinking on data, digital and AI in national health and public services, from the AImpetus founders."
>
  <PageHeader
    crumbLabel="Insights"
    title="Insights"
    intro="Practical thinking on making data, digital and AI work in public services. No hype, just what we've learned from delivery."
  >
    <p class="follow">
      {COMPANY_LINKEDIN ? (
        <a href={COMPANY_LINKEDIN}>Follow AImpetus on LinkedIn</a>
      ) : (
        <>Follow AImpetus on LinkedIn <Placeholder text="company LinkedIn page" /></>
      )}
    </p>
  </PageHeader>

  <section class="section on-paper wm">
    <div class="wrap">
      <!-- TODO: copy to approve (not in the brief) -->
      <p class="soon">Our first articles are coming soon. Follow us on LinkedIn to see them first.</p>

      <!-- Decorative: empty article cards, showing where articles will appear -->
      <ul class="skeletons" aria-hidden="true">
        {[1, 2, 3].map(() => (
          <li class="skeleton">
            <span class="sk sk--tag"></span>
            <span class="sk sk--title"></span>
            <span class="sk sk--title sk--short"></span>
            <span class="sk sk--line"></span>
            <span class="sk sk--line sk--short"></span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .follow {
    font-weight: 600;
  }

  .soon {
    max-width: 34rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--grid-line);
    border-left: 6px solid var(--teal);
    border-radius: var(--radius-card);
    background: var(--white);
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 1.1rem + 0.8vw, 1.625rem);
    font-weight: 700;
    line-height: 1.3;
  }

  .skeletons {
    display: grid;
    gap: 1.25rem;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48em) {
    .skeletons {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .skeleton {
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem;
    border: 1px dashed #b7c3bf;
    border-top: 5px solid #d5dbd7;
    border-radius: var(--radius-card);
    background: rgba(255, 255, 255, 0.6);
  }

  .sk {
    display: block;
    height: 0.75rem;
    border-radius: 1rem;
    background: #e2e8e5;
  }

  .sk--tag {
    width: 30%;
    height: 1.25rem;
    margin-bottom: 0.5rem;
    border-radius: 0.25rem;
    background: #d3ebe6;
  }

  .sk--title {
    height: 1.125rem;
    background: #d5dbd7;
  }

  .sk--short {
    width: 65%;
  }

  .sk--line {
    margin-top: 0.25rem;
  }
</style>
