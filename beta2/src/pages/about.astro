---
// Beta 2 About us – copy from brief/website-content.pdf ("About us page").
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import IndexHead from '../components/IndexHead.astro';
import FeatureIcon from '../components/FeatureIcon.astro';
import FounderPortrait from '../components/FounderPortrait.astro';
import ArrowLink from '../components/ArrowLink.astro';
import CtaPanel from '../components/CtaPanel.astro';
import { url } from '../lib/paths';
import { brandify } from '../lib/brand';

const whyNow = [
  { icon: 'target', lead: 'Outcomes, not hype.', text: 'The real test is benefit delivered: better services, lower costs and measurable impact. Technology is the means, not the goal.' },
  { icon: 'organisation', lead: 'Understanding the business matters as much as the technology.', text: 'AI and digital tools move fast. Knowing how an organisation really works, its people, pressures and priorities, matters just as much.' },
  { icon: 'foundation', lead: 'The groundwork is the gap.', text: "The tools are ready. What often isn't ready is the data, the platforms and the governance underneath. That's exactly where we work." },
] as const;

const founders = [
  {
    id: 'prahlad',
    slug: 'prahlad-koti',
    name: 'Prahlad Koti',
    initials: 'PK',
    role: 'Co-founder and Managing Director',
    bio: [
      'Prahlad has spent more than 30 years building and running technology services businesses in the UK. At Mastek he rose from a technical support role to UK Managing Director, having led its Government and Health business and set up its healthcare practice. Along the way he led major public-sector bids, including the pricing and negotiation of a nine-year contract, and grew a FTSE 100 healthcare account threefold in five years.',
      'He went on to become a Partner at Netcompany and Chief Operating Officer at Scrumconnect Consulting, a UK digital company focused on public-sector services. He also advises founders and boards on growth and operational resilience.',
      'At AImpetus, Prahlad leads commercial strategy, partnerships and business development. He holds an MBA from London Business School and a degree in Computer Science.',
    ],
    linkedin: 'https://www.linkedin.com/in/prahlad-koti/',
    linkText: 'Connect with Prahlad on LinkedIn',
  },
  {
    id: 'deepak',
    slug: 'deepak-thaper',
    name: 'Deepak Thaper',
    initials: 'DT',
    role: 'Co-founder and Delivery & Technology Director',
    bio: [
      "Deepak has spent nearly 30 years delivering technology programmes, the last decade and more inside the NHS. At Mastek he led data warehousing and analytics work for NHS Improvement. He then directed NHS England programmes spanning cloud, DevOps and modern data platforms such as Azure Synapse and Palantir Foundry, before becoming Vice President of Delivery for UK Healthcare. His NHS cloud work earned Mastek's CEO Award for Excellence.",
      'More recently he has led delivery and strategy within AI-native organisations and the AI start-up ecosystem, helping organisations move from AI experiments to practical, well-governed adoption.',
      'At AImpetus, Deepak leads delivery, architecture and AI. He holds an MBA, a professional certificate in applied data science and AI/ML from IIT Palakkad, AgilePM Practitioner certification, and certifications in AI security and governance.',
    ],
    linkedin: 'https://www.linkedin.com/in/deepak-thaper-80246113/',
    linkText: 'Connect with Deepak on LinkedIn',
  },
];

const beliefs = [
  { icon: 'target', lead: 'Outcomes before technology.', text: 'We start with the service and the people who use it.' },
  { icon: 'evidence', lead: 'Evidence before scale.', text: 'Prove it works, then grow it.' },
  { icon: 'honest', lead: 'Honesty before sales.', text: "We'd rather lose a deal than oversell." },
  { icon: 'public', lead: 'Public value.', text: 'Every pound of public money should do real work.' },
] as const;

const toc = [
  { id: 'started-heading', label: 'Why we started AImpetus' },
  { id: 'now-heading', label: 'Why now' },
  { id: 'founders-heading', label: 'Our founders' },
  { id: 'believe-heading', label: 'What we believe' },
];
---
<BaseLayout
  title="About us | AImpetus"
  description="AImpetus is a UK data, digital and AI services company founded by Prahlad Koti and Deepak Thaper, with 60 years of combined experience."
>
  <PageHeader
    crumbLabel="About us"
    title="A new company. A proven team."
    intro="AImpetus is a UK data, digital and AI services company. We were founded in 2026 by two people who have spent their careers delivering technology for the NHS and the wider public sector."
    toc={toc}
  />

  <section class="section on-paper" aria-labelledby="started-heading">
    <div class="wrap">
      <IndexHead id="started-heading" index="01" text="Why we started AImpetus" />
      <div class="story">
        <p class="lede">We've seen too many promising data and AI ideas stall before they reached a live service. The technology usually works. What's missing is the groundwork: reliable data, modern platforms, sound governance and steady delivery. AImpetus exists to put that groundwork in place, so AI can do real work in the engine room of public services.</p>
        <div class="name-card">
          <span class="name-card__mark" aria-hidden="true">
            <svg viewBox="0 0 48 48" focusable="false">
              <polygon points="9,12 18,12 28,24 18,36 9,36 19,24" fill="#F59E0B" />
              <polygon points="22,12 30,12 40,24 30,36 22,36 32,24" fill="#5EEAD4" />
            </svg>
          </span>
          <p>The name says what we're for: AI, and the impetus to move good ideas into everyday use.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section band-white" aria-labelledby="now-heading">
    <div class="wrap">
      <IndexHead
        id="now-heading"
        index="02"
        text="Why now"
        intro="AI has moved from experiment to expectation. But the organisations that gain most won't be the ones with the most technology. They'll be the ones that stay focused on outcomes. That's why we started AImpetus now."
      />
      <ol class="ruled">
        {whyNow.map((item, i) => (
          <li class="ruled__cell">
            <div class="ruled__top">
              <span class="ruled__chip"><FeatureIcon name={item.icon} /></span>
              <span class="ruled__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="ruled__lead">{item.lead}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ol>
      <p class="lede now__close">We both stepped out of conventional IT services to see the work from a different angle: new technology, new ways of delivering services, and the ground reality of making change stick. AImpetus brings that experience together, so the organisations we work with get the benefit, not the hype.</p>
    </div>
  </section>

  <section class="section band-ink" aria-labelledby="founders-heading">
    <div class="wrap">
      <IndexHead id="founders-heading" index="03" text="Our founders" />
      <div class="founders">
        {founders.map((f) => (
          <article class="founder" aria-labelledby={`${f.id}-name`}>
            <div class="founder__side">
              <FounderPortrait slug={f.slug} initials={f.initials} size="lg" />
              <h3 id={`${f.id}-name`}>{f.name}</h3>
              <p class="founder__role">{f.role}</p>
              <ArrowLink href={f.linkedin}>{f.linkText}</ArrowLink>
            </div>
            <div class="founder__bio">
              {f.bio.map((para) => <p>{para}</p>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section on-paper" aria-labelledby="believe-heading">
    <div class="wrap">
      <IndexHead id="believe-heading" index="04" text="What we believe" />
      <ul class="ruled ruled--4">
        {beliefs.map((item) => (
          <li class="ruled__cell">
            <div class="ruled__top">
              <span class="ruled__chip"><FeatureIcon name={item.icon} /></span>
            </div>
            <h3 class="ruled__lead">{item.lead}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaPanel button="Book a 30-minute conversation" href={url('contact/')} />
</BaseLayout>

<style>
  .story {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 60em) {
    .story {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: clamp(3rem, 6vw, 5rem);
    }
  }

  .story .lede {
    max-width: var(--measure);
  }

  .name-card {
    display: grid;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--grid-line);
    border-top: 5px solid var(--amber);
    border-radius: var(--radius-card);
    background: var(--white);
  }

  .name-card__mark {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.375rem;
    background: var(--ink);
  }

  .name-card__mark svg {
    width: 2rem;
    height: 2rem;
  }

  .name-card p {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--ink);
  }

  /* Ruled grids (shared borders) */
  .ruled {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--grid-line);
    border-radius: var(--radius-card);
    background: var(--grid-line);
    overflow: hidden;
  }

  @media (min-width: 48em) {
    .ruled {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .ruled--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64em) {
    .ruled--4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .ruled__cell {
    display: grid;
    align-content: start;
    gap: 0.625rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    background: var(--white);
  }

  .band-white .ruled__cell {
    background: var(--paper);
  }

  .ruled__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .ruled__chip {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.375rem;
    background: var(--ink);
  }

  .ruled__num {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--slate);
  }

  .ruled__lead {
    font-size: 1.25rem;
    line-height: 1.25;
  }

  .now__close {
    max-width: 52rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-left: 1.25rem;
    border-left: 4px solid var(--teal);
  }

  /* Founders: large profile cards on ink */
  .founders {
    display: grid;
    gap: 1.5rem;
  }

  .founder {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid #2f5a60;
    border-radius: var(--radius-card);
    background: linear-gradient(170deg, #14383e, #0d272b);
  }

  @media (min-width: 56em) {
    .founder {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: clamp(2rem, 4vw, 3.5rem);
    }
  }

  .founder__side {
    display: grid;
    align-content: start;
    gap: 0.5rem;
  }

  .founder__side :global(.portrait) {
    width: min(100%, 12rem);
    margin-bottom: 1rem;
  }

  .founder h3 {
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
  }

  .founder__role {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #2f5a60;
    color: var(--mint);
    font-weight: 600;
  }

  .founder__bio {
    max-width: 44rem;
  }
</style>
