---
// Cookie notice – copy from brief/legal-pages.pdf. SEO title is builder-drafted.
import LegalLayout from '../layouts/LegalLayout.astro';
import DataTable from '../components/DataTable.astro';

const ph = (text: string) => `<mark class="placeholder">[Placeholder: ${text}]</mark>`;
const cookies = [
  [ph('name'), ph('hosting provider'), 'Security and keeping the site running', 'Strictly necessary', ph('duration')],
  [ph('name'), ph('booking tool'), 'Making the booking calendar work, if embedded', 'Strictly necessary', ph('duration')],
];
---
<LegalLayout title="Cookie notice | AImpetus" heading="Cookie notice" sections={[{"id": "cookies-we-use", "label": "Cookies we use"}, {"id": "analytics-only-if-we-add-them", "label": "Analytics (only if we add them)"}, {"id": "managing-cookies", "label": "Managing cookies"}, {"id": "contact", "label": "Contact"}]}>
  <p class="lede">Cookies are small files a website stores on your device. Some are essential to make a site work. Others, such as analytics cookies, are optional.</p>

  <h2 id="cookies-we-use">Cookies we use</h2>
  <p>We keep cookies to a minimum. At launch, aimpetus.ai uses only strictly necessary cookies, which the site needs to work securely. These don't need your consent.</p>
  <DataTable columns={['Cookie', 'Provider', 'Purpose', 'Type', 'How long']} rows={cookies} />

  <h2 id="analytics-only-if-we-add-them">Analytics (only if we add them)</h2>
  <p>If we add analytics to understand how people use the site, we'll ask for your consent first through a cookie banner, and only set those cookies if you agree. You'll be able to change your choice at any time using the "Cookie settings" link in the footer.</p>

  <h2 id="managing-cookies">Managing cookies</h2>
  <p>You can also block or delete cookies in your browser settings. Blocking strictly necessary cookies may stop parts of the site working.</p>

  <h2 id="contact">Contact</h2>
  <p>Questions about cookies? Email <a href="mailto:contact@aimpetus.ai">contact@aimpetus.ai</a>.</p>
</LegalLayout>
