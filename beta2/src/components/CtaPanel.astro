---
// Beta 2 closing call to action: a boxed ink panel inside a paper section.
import Button from './Button.astro';
import { brandify } from '../lib/brand';
interface Props { heading?: string; text?: string; button: string; href: string; id?: string }
const { heading, text, button, href, id = 'cta-heading' } = Astro.props;
---
<section class="on-paper cta-wrap" aria-labelledby={heading ? id : undefined} aria-label={heading ? undefined : button}>
  <div class="wrap">
    <div class:list={['cta-panel', { 'cta-panel--compact': !heading }]}>
      {(heading || text) && (
        <div class="cta-panel__text">
          {heading && <h2 id={id} set:html={brandify(heading)} />}
          {text && <p class="lede">{text}</p>}
        </div>
      )}
      <div class="cta-panel__action">
        <Button href={href}>{button}</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-wrap {
    padding-block: clamp(2.5rem, 5vw, 4rem) var(--section-space);
  }

  .cta-panel {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: clamp(2rem, 5vw, 4rem);
    border-left: 6px solid var(--mint);
    border-radius: var(--radius-card);
    background:
      linear-gradient(to right, rgba(94, 234, 212, 0.06) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(to bottom, rgba(94, 234, 212, 0.06) 1px, transparent 1px) 0 0 / 40px 40px,
      var(--ink);
    color: var(--paper);
    --heading: var(--white);
    --link: var(--mint);
    --focus: var(--white);
  }

  @media (min-width: 60em) {
    .cta-panel {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4rem;
    }
  }

  .cta-panel--compact {
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
  }

  .cta-panel h2 {
    max-width: 18ch;
    color: var(--white);
  }

  .cta-panel .lede {
    max-width: 38rem;
  }

  .cta-panel h2 + .lede {
    margin-top: 1.25rem;
  }

  .cta-wrap .cta-panel :global(.button) {
    --button-bg: var(--mint);
    --button-bg-hover: var(--mint-light);
    --button-text: var(--ink);
  }
</style>
