---
// Beta 2 closing call to action: a boxed ink panel inside a paper section.
import Button from './Button.astro';
import ChevronBlocks from './ChevronBlocks.astro';
import { brandify } from '../lib/brand';
interface Props { heading?: string; text?: string; button: string; href: string; id?: string }
const { heading, text, button, href, id = 'cta-heading' } = Astro.props;
---
<section class="on-paper cta-wrap" aria-labelledby={heading ? id : undefined} aria-label={heading ? undefined : button}>
  <div class="wrap">
    <div class:list={['cta-panel', { 'cta-panel--compact': !heading }]}>
      {(heading || text) && (
        <div class="cta-panel__text">
          {heading && <h2 id={id} set:html={brandify(heading)} />}
          {text && <p class="lede">{text}</p>}
        </div>
      )}
      <div class="cta-panel__action">
        <Button href={href}>{button}</Button>
      </div>
      <div class="cta-panel__blocks" aria-hidden="true"><ChevronBlocks /></div>
    </div>
  </div>
</section>

<style>
  .cta-wrap {
    padding-block: clamp(2.5rem, 5vw, 4rem) var(--section-space);
  }

  /* Arrow-shaped banner with the signature chevron blocks at its point */
  .cta-panel {
    position: relative;
    display: grid;
    gap: 2rem;
    align-items: center;
    overflow: hidden;
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: var(--radius-card);
    background:
      radial-gradient(ellipse 60% 120% at 0% 0%, rgba(94, 234, 212, 0.14), transparent 60%),
      linear-gradient(120deg, var(--ink) 40%, #0f4a47 100%);
    color: var(--paper);
    --heading: var(--white);
    --link: var(--mint);
    --focus: var(--white);
  }

  .cta-panel__blocks {
    display: none;
  }

  @media (min-width: 60em) {
    .cta-panel {
      grid-template-columns: minmax(0, 1fr) auto 20rem;
      gap: 3rem;
      padding-right: 0;
      clip-path: polygon(0 0, calc(100% - 4rem) 0, 100% 50%, calc(100% - 4rem) 100%, 0 100%);
      border-radius: var(--radius-card) 0 0 var(--radius-card);
    }

    .cta-panel__blocks {
      display: block;
      align-self: stretch;
      margin-block: calc(-1 * clamp(2rem, 5vw, 4rem));
    }

    .cta-panel__blocks :global(.chevron-blocks) {
      height: 100%;
    }
  }

  .cta-panel--compact {
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
  }

  @media (min-width: 60em) {
    .cta-panel--compact {
      grid-template-columns: auto minmax(0, 1fr) 14rem;
    }

    .cta-panel--compact .cta-panel__blocks {
      margin-block: calc(-1 * clamp(1.5rem, 3vw, 2.25rem));
      grid-column: 3;
    }
  }

  .cta-panel h2 {
    max-width: 18ch;
    color: var(--white);
  }

  .cta-panel .lede {
    max-width: 38rem;
  }

  .cta-panel h2 + .lede {
    margin-top: 1.25rem;
  }

  .cta-wrap .cta-panel :global(.button) {
    --button-bg: var(--mint);
    --button-bg-hover: var(--mint-light);
    --button-text: var(--ink);
  }
</style>
