---
// Beta 2 signature: ONE logo chevron stroke, cropped so only the tip of the upper
// arm shows and the full lower arm runs off the bottom – a diagonal "split" of the
// area, with a slightly lighter tone on the far side. Arm angle matches the logo
// mark (dx 10 : dy 12). Decorative only; the parent sizes and crops it.
interface Props { tone?: 'mint' | 'teal'; class?: string }
const { tone = 'mint', class: className = '' } = Astro.props;
---
<svg class:list={['split-band', `split-band--${tone}`, className]} viewBox="0 0 600 700" preserveAspectRatio="xMinYMin slice" aria-hidden="true" focusable="false">
  <!-- Far side of the split: a slightly lighter tone -->
  <polygon class="split-band__far" points="502,0 600,0 600,700 35,700 560,70" />
  <!-- The chevron stroke: short upper arm (top edge to tip), long lower arm -->
  <polygon class="split-band__stroke" points="392,0 502,0 560,70 35,700 -75,700 450,70" />
</svg>

<style>
  .split-band {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .split-band__far {
    fill: #12393e;
  }

  .split-band--mint .split-band__stroke {
    fill: var(--mint);
  }

  .split-band--teal .split-band__stroke {
    fill: var(--teal);
  }

  .split-band--teal .split-band__far {
    fill: #113a3f;
  }

  @media (forced-colors: active) {
    .split-band {
      display: none;
    }
  }
</style>
