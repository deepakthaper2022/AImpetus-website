---
// Beta 2 service cards: problem → outcome. "The problem" / "The outcome" labels are
// builder-drafted (brief/copy-changes.md). With explore=true the card shows the
// Services page "Explore …" link instead of linking the name.
import ServiceIcon from './ServiceIcon.astro';
import Chevron from './Chevron.astro';
import ArrowLink from './ArrowLink.astro';
import { services } from '../data/services';
import { url } from '../lib/paths';
import { brandify } from '../lib/brand';
interface Props { explore?: boolean }
const { explore = false } = Astro.props;
---
<ul class="po-grid">
  {services.map((s) => (
    <li class:list={['po', `po--${s.icon}`]} id={explore ? `service-${s.slug}` : undefined}>
      <div class="po__head">
        <span class="po__icon"><ServiceIcon name={s.icon} /></span>
        <h3 class="po__name">
          {explore ? <span set:html={brandify(s.name)} /> : <a href={url(`services/${s.slug}/`)} class="po__link" set:html={brandify(s.name)} />}
        </h3>
      </div>
      <dl class="po__body">
        <div class="po__row po__row--problem">
          <dt>The problem</dt>
          <dd>{s.forWhen}</dd>
        </div>
        <div class="po__row po__row--outcome">
          <dt>The outcome</dt>
          <dd>{s.homeLine}</dd>
        </div>
      </dl>
      {explore ? (
        <div class="po__foot"><ArrowLink href={url(`services/${s.slug}/`)} class="po__link">{s.explore}</ArrowLink></div>
      ) : (
        <span class="po__go" aria-hidden="true"><Chevron /></span>
      )}
    </li>
  ))}
</ul>

<style>
  .po-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48em) {
    .po-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .po {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    border: 1px solid var(--grid-line);
    border-top: 5px solid var(--po-accent, var(--teal));
    border-radius: var(--radius-card);
    background: var(--white);
    box-shadow: 0 1px 0 rgba(14, 42, 47, 0.04), 0 16px 36px -26px rgba(14, 42, 47, 0.45);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .po:hover,
  .po:focus-within {
    transform: translateY(-3px);
    box-shadow: 0 24px 44px -26px rgba(15, 118, 110, 0.5);
  }

  .po--data { --po-accent: #0f766e; }
  .po--ai { --po-accent: #f59e0b; }
  .po--digital { --po-accent: #0e2a2f; }
  .po--assurance { --po-accent: #14b8a6; }

  .po__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem 1.5rem 1.25rem;
  }

  @media (min-width: 30em) {
    .po__head {
      flex-direction: row;
      align-items: center;
      padding-inline: 1.75rem;
    }
  }

  .po__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 0.375rem;
    background: var(--ink);
    --icon-line: var(--mint);
  }

  .po__icon :global(.service-icon) {
    width: 2rem;
    height: 2rem;
  }

  .po__name {
    min-width: 0;
    font-size: clamp(1.375rem, 1.15rem + 0.9vw, 1.75rem);
    padding-right: 2rem;
  }

  .po__link {
    color: var(--ink);
    text-decoration: none;
  }

  .po :global(.po__link)::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .po:hover :global(.po__link) {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .po :global(.po__link:focus-visible) {
    outline: none;
  }

  .po :global(.po__link:focus-visible)::after {
    outline: var(--focus-width) solid var(--ink);
    outline-offset: 3px;
    border-radius: var(--radius-card);
  }

  .po__body {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--grid-line);
  }

  .po__row {
    display: grid;
    gap: 0.375rem;
    padding: 1.125rem 1.5rem;
  }

  @media (min-width: 30em) {
    .po__row {
      padding-inline: 1.75rem;
    }
  }

  .po__row--outcome {
    border-top: 1px dashed var(--grid-line);
    background: #f1f7f5;
  }

  .po__row dt {
    color: var(--slate);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .po__row--outcome dt {
    color: var(--teal-dark);
  }

  .po__row dd {
    margin: 0;
  }

  .po__row--outcome dd {
    color: var(--ink);
    font-weight: 600;
  }

  .po__go {
    position: absolute;
    top: 1.75rem;
    right: 1.5rem;
    --accent: var(--teal);
  }

  .po__go :global(.chevron) {
    width: 0.9rem;
    height: 1.1rem;
  }


  .po {
    grid-template-rows: auto 1fr auto;
  }

  .po__foot {
    padding: 0.75rem 1.75rem 1.25rem;
    border-top: 1px solid var(--grid-line);
  }

  .po__foot :global(.arrow-link) {
    color: var(--teal-dark);
  }
</style>
