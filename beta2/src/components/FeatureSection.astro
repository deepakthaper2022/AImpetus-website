---
// Paper section with the heading in a sticky left column and feature cards on the
// right. The first card is a dark "featured" card. Used for Why AImpetus, What you
// can expect, What we do, Why now and What we believe.
import Chevron from './Chevron.astro';
import FeatureIcon, { type FeatureIconName } from './FeatureIcon.astro';
import { brandify } from '../lib/brand';

interface Item { lead: string; text: string; icon?: FeatureIconName }
interface Props {
  id: string;
  heading: string;
  items: Item[];
  intro?: string;
  /** Hidden punctuation after each lead, for copy written as "Term: text" */
  leadSuffix?: string;
  ordered?: boolean;
}
const { id, heading, items, intro, leadSuffix = '', ordered = true } = Astro.props;
const List = ordered ? 'ol' : 'ul';
// With a full-width featured card first, make the last card full width if the rest are odd
const lastWide = (items.length - 1) % 2 === 1;
---
<section class="section on-paper features" aria-labelledby={id}>
  <div class="features__watermark" aria-hidden="true"></div>
  <div class="wrap features__layout">
    <div class="features__aside">
      <Chevron class="features__marker" />
      <h2 id={id} set:html={brandify(heading)} />
      {intro && <p class="lede features__intro">{intro}</p>}
      <div class="features__count" aria-hidden="true">{String(items.length).padStart(2, '0')}</div>
    </div>

    <List class="features__grid">
      {items.map((item, i) => (
        <li class:list={['feature', { 'feature--lead': i === 0, 'feature--wide': lastWide && i === items.length - 1 && i !== 0 }]}>
          <div class="feature__top">
            {item.icon ? (
              <span class="feature__chip"><FeatureIcon name={item.icon} /></span>
            ) : (
              <span class="feature__chip feature__chip--mark">
                <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                  <polygon points="9,12 18,12 28,24 18,36 9,36 19,24" fill="#F59E0B" />
                  <polygon points="22,12 30,12 40,24 30,36 22,36 32,24" fill="#5EEAD4" />
                </svg>
              </span>
            )}
            <span class="feature__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <h3 class="feature__lead"><span set:html={brandify(item.lead)} />{leadSuffix && <span class="visually-hidden">{leadSuffix}</span>}</h3>
          <p class="feature__text">{item.text}</p>
        </li>
      ))}
    </List>
  </div>
  <slot />
</section>

<style>
  .features {
    position: relative;
    overflow: hidden;
    /* Subtle engineering dot grid on paper */
    background:
      radial-gradient(circle, #d9dfdb 1px, transparent 1.2px) 0 0 / 22px 22px,
      var(--paper);
  }

  .features__watermark {
    position: absolute;
    right: -6rem;
    bottom: -8rem;
    width: 34rem;
    height: 34rem;
    background: var(--teal);
    opacity: 0.05;
    clip-path: polygon(0 0, 45% 0, 100% 50%, 45% 100%, 0 100%, 55% 50%);
    pointer-events: none;
  }

  .features__layout {
    position: relative;
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 64em) {
    .features__layout {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      column-gap: clamp(3rem, 5vw, 5rem);
      align-items: start;
    }

    .features__aside {
      position: sticky;
      top: 2rem;
    }
  }

  .features__aside :global(.features__marker) {
    display: block;
    width: 1rem;
    height: 1.2rem;
    margin-bottom: 1.25rem;
  }

  .features__aside h2 {
    max-width: 16ch;
  }

  @media (min-width: 64em) {
    .features__aside h2 {
      max-width: none;
    }
  }

  .features__intro {
    max-width: 30rem;
    margin-top: 1.25rem;
  }

  .features__count {
    display: none;
  }

  @media (min-width: 64em) {
    .features__count {
      display: block;
      margin-top: 2rem;
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 7rem;
      line-height: 1;
      letter-spacing: -0.04em;
      color: transparent;
      -webkit-text-stroke: 2px rgba(15, 118, 110, 0.35);
    }
  }

  .features__grid {
    display: grid;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40em) {
    .features__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .feature--lead,
    .feature--wide {
      grid-column: 1 / -1;
    }
  }

  .feature {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid var(--rule-on-paper);
    border-radius: 1.25rem;
    background:
      radial-gradient(ellipse 80% 60% at 100% 0%, rgba(94, 234, 212, 0.12), transparent 60%),
      var(--white);
    box-shadow: 0 1px 0 rgba(14, 42, 47, 0.04), 0 14px 34px -22px rgba(14, 42, 47, 0.35);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .feature:hover {
    transform: translateY(-3px);
    border-color: var(--teal);
    box-shadow: 0 20px 40px -24px rgba(15, 118, 110, 0.45);
  }

  .feature__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .feature__chip {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 0.875rem;
    background: linear-gradient(160deg, #15393f, var(--ink));
    box-shadow: inset 0 0 0 1px #2f5a60;
  }

  .feature__chip--mark svg {
    width: 1.875rem;
    height: 1.875rem;
  }

  .feature__num {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.05em;
    color: var(--slate);
  }

  .feature__lead {
    font-size: clamp(1.1875rem, 1.05rem + 0.5vw, 1.4375rem);
    line-height: 1.25;
    color: var(--ink);
  }

  .feature__text {
    color: #26393c;
  }

  /* Featured first card: dark */
  .feature--lead {
    border-color: #24484e;
    background:
      radial-gradient(ellipse 70% 90% at 100% 0%, rgba(94, 234, 212, 0.18), transparent 60%),
      linear-gradient(150deg, #15393f 0%, var(--ink) 70%);
    color: var(--paper);
  }

  .feature--lead:hover {
    border-color: var(--mint);
  }

  .feature--lead .feature__chip {
    background: rgba(94, 234, 212, 0.1);
    box-shadow: inset 0 0 0 1px rgba(94, 234, 212, 0.35);
  }

  .feature--lead .feature__num {
    color: var(--muted-on-ink);
  }

  .feature--lead .feature__lead {
    color: var(--white);
    font-size: clamp(1.375rem, 1.15rem + 0.9vw, 1.875rem);
  }

  .feature--lead .feature__text {
    max-width: 40rem;
    color: var(--paper);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  /* Focus inside a dark card */
  .feature--lead :global(:focus-visible) {
    outline-color: var(--white);
  }

  @media (forced-colors: active) {
    .feature {
      border: 1px solid CanvasText;
    }
  }
</style>
