---
// Beta 2 interior page header: compact dark band with breadcrumbs, H1 and intro,
// plus an "On this page" card of numbered jump links (when sections are given).
import Breadcrumbs from './Breadcrumbs.astro';
import SplitBand from './SplitBand.astro';
import { brandify } from '../lib/brand';
import { url } from '../lib/paths';

interface Crumb { label: string; href?: string }
interface TocItem { id: string; label: string }
interface Props {
  title: string;
  intro?: string;
  crumbs?: Crumb[];
  toc?: TocItem[];
  /** Small label above the H1, e.g. the parent section */
  kicker?: string;
  /** Short name for the breadcrumb (defaults to the title) */
  crumbLabel?: string;
}
const { title, intro, crumbs, toc, kicker, crumbLabel } = Astro.props;
const trail = crumbs ?? [{ label: 'Home', href: url('') }, { label: crumbLabel ?? title }];
---
<section class:list={['page-header', { 'page-header--toc': toc?.length }]} aria-labelledby="page-title">
  <div class="page-header__band"><SplitBand tone="teal" /></div>
  <div class="wrap page-header__inner">
    <div class="page-header__main">
      <Breadcrumbs items={trail} />
      {kicker && <p class="page-header__kicker">{kicker}</p>}
      <h1 id="page-title" set:html={brandify(title)} />
      {intro && <p class="lede page-header__intro">{intro}</p>}
      <slot />
    </div>

    {toc && toc.length > 0 && (
      <nav class="toc" aria-labelledby="toc-title">
        <p class="toc__title" id="toc-title">On this page</p>
        <ol class="toc__list">
          {toc.map((item, i) => (
            <li>
              <a href={`#${item.id}`}>
                <span class="toc__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span set:html={brandify(item.label)} />
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}
  </div>
</section>

<style>
  .page-header {
    position: relative;
    overflow: hidden;
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) clamp(2.5rem, 2rem + 3vw, 4rem);
    border-bottom: 4px solid var(--mint);
    background:
      linear-gradient(to right, rgba(94, 234, 212, 0.07) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(to bottom, rgba(94, 234, 212, 0.07) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(135deg, var(--ink) 60%, #10403f 100%);
  }

  /* Signature split band (quiet teal), cropped at the right edge on wide screens */
  .page-header__band {
    display: none;
  }

  @media (min-width: 60em) {
    .page-header__band {
      display: block;
      position: absolute;
      top: 0;
      bottom: 0;
      left: 62%;
      right: 0;
    }

    /* Keep text clear of the band */
    .page-header:not(.page-header--toc) .page-header__main {
      max-width: 56%;
    }
  }

  .page-header__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 60em) {
    .page-header--toc .page-header__inner {
      grid-template-columns: minmax(0, 7fr) minmax(16rem, 4fr);
      gap: clamp(2rem, 5vw, 5rem);
    }
  }

  .page-header__kicker {
    margin-bottom: 0.75rem;
    color: var(--mint);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .page-header h1 {
    max-width: 20ch;
    font-size: clamp(2.125rem, 1.4rem + 3vw, 3.75rem);
    line-height: 1.06;
  }

  .page-header__intro {
    max-width: 42rem;
    margin-top: clamp(1rem, 2vw, 1.5rem);
  }

  .page-header__main :global(> .button),
  .page-header__main :global(> .actions),
  .page-header__main :global(> p:not(.lede):not(.page-header__kicker)) {
    margin-top: 1.5rem;
  }

  /* "On this page" card */
  .toc {
    padding: 1.25rem 1.25rem 0.75rem;
    border: 1px solid #2f5a60;
    border-radius: var(--radius-card);
    background: #0b2328;
    box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.7);
  }

  @media (min-width: 60em) {
    .toc {
      margin-top: 3.25rem;
    }
  }

  .toc__title {
    margin-bottom: 0.5rem;
    color: var(--muted-on-ink);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .toc__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc__list li + li {
    border-top: 1px solid #24484e;
  }

  .toc__list a {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-height: 2.75rem;
    padding-block: 0.375rem;
    color: var(--paper);
    font-weight: 600;
    text-decoration: none;
  }

  .toc__list a:hover {
    color: var(--mint);
    text-decoration: underline;
  }

  .toc__num {
    flex: none;
    display: inline-grid;
    place-items: center;
    min-width: 2.25rem;
    height: 1.5rem;
    border-radius: 0.25rem;
    background: rgba(94, 234, 212, 0.12);
    color: var(--mint);
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 700;
  }
</style>
