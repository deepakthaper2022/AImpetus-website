---
// Beta 2 hero artwork: three overlapping "interface" panels – the four services,
// a benefit chart and the Understand → Prove → Scale checklist. Decorative only.
import ServiceIcon from './ServiceIcon.astro';
---
<div class="panels" aria-hidden="true">
  <!-- Back: the four services -->
  <div class="panel panel--services">
    <div class="panel__bar"><span></span><span></span><span></span></div>
    <div class="services-grid">
      <span class="svc"><ServiceIcon name="data" /></span>
      <span class="svc"><ServiceIcon name="ai" /></span>
      <span class="svc"><ServiceIcon name="digital" /></span>
      <span class="svc"><ServiceIcon name="assurance" /></span>
    </div>
  </div>

  <!-- Middle: benefit over time -->
  <div class="panel panel--chart">
    <div class="panel__bar"><span></span><span></span><span></span></div>
    <svg viewBox="0 0 240 130" focusable="false">
      <g stroke="#2A4A50">
        <line x1="10" y1="120" x2="230" y2="120" />
        <line x1="10" y1="85" x2="230" y2="85" stroke-dasharray="2 6" />
        <line x1="10" y1="50" x2="230" y2="50" stroke-dasharray="2 6" />
      </g>
      <rect x="26" y="92" width="26" height="28" rx="3" fill="none" stroke="#3B6168" stroke-width="2" stroke-dasharray="4 4" />
      <rect x="74" y="74" width="26" height="46" rx="3" fill="none" stroke="#5EEAD4" stroke-opacity="0.6" stroke-width="2" stroke-dasharray="4 4" />
      <rect x="122" y="52" width="26" height="68" rx="3" fill="#5EEAD4" fill-opacity="0.75" />
      <rect x="170" y="24" width="26" height="96" rx="3" fill="#5EEAD4" />
      <polyline points="39,86 87,66 135,44 178,18" fill="none" stroke="#F59E0B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="178" cy="18" r="5" fill="#F59E0B" />
    </svg>
  </div>

  <!-- Front: the approach as a checklist -->
  <div class="panel panel--steps">
    <ol class="steps">
      <li class="done"><span class="tick"></span><span class="label">Understand</span></li>
      <li class="done"><span class="tick"></span><span class="label">Prove</span></li>
      <li class="current"><span class="tick"></span><span class="label">Scale or stop</span></li>
    </ol>
    <div class="progress"><span></span></div>
  </div>
</div>

<style>
  .panels {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 0.92;
  }

  .panel {
    position: absolute;
    border: 1px solid #2f5a60;
    border-radius: 0.625rem;
    background: linear-gradient(160deg, #163c42 0%, #0c2529 100%);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(94, 234, 212, 0.04);
  }

  .panel__bar {
    display: flex;
    gap: 0.375rem;
    padding: 0.75rem 0.875rem;
    border-bottom: 1px solid #24484e;
  }

  .panel__bar span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #3b6168;
  }

  .panel__bar span:first-child {
    background: var(--amber);
  }

  .panel--services {
    top: 0;
    right: 0;
    width: 58%;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.625rem;
    padding: 0.875rem;
  }

  .svc {
    display: grid;
    place-items: center;
    aspect-ratio: 1.3;
    border: 1px solid #24484e;
    border-radius: 0.375rem;
    background: rgba(94, 234, 212, 0.05);
  }

  .svc :global(.service-icon) {
    width: 46%;
    height: auto;
  }

  .panel--chart {
    top: 30%;
    left: 0;
    width: 62%;
  }

  .panel--chart svg {
    display: block;
    width: 100%;
    height: auto;
    padding: 0.5rem 0.75rem 0.75rem;
  }

  .panel--steps {
    right: 6%;
    bottom: 0;
    width: 54%;
    padding: 1rem 1.125rem 1.125rem;
    border-color: rgba(94, 234, 212, 0.45);
  }

  .steps {
    display: grid;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--paper);
    font-size: clamp(0.8125rem, 0.7rem + 0.4vw, 1rem);
    font-weight: 600;
  }

  .tick {
    position: relative;
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
    border: 2px solid var(--mint);
    border-radius: 50%;
  }

  .done .tick {
    background: var(--mint);
  }

  .done .tick::after {
    content: '';
    position: absolute;
    left: 0.36rem;
    top: 0.14rem;
    width: 0.3rem;
    height: 0.6rem;
    border: solid var(--ink);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .current .tick::after {
    content: '';
    position: absolute;
    inset: 0.22rem;
    border-radius: 50%;
    background: var(--amber);
  }

  .progress {
    height: 0.375rem;
    margin-top: 1rem;
    border-radius: 1rem;
    background: #24484e;
    overflow: hidden;
  }

  .progress span {
    display: block;
    width: 72%;
    height: 100%;
    background: linear-gradient(to right, var(--mint), var(--amber));
  }
</style>
