---
// The four service pages. Copy lives in src/data/services.ts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import type { ArtName } from '../../components/PageArt.astro';
import SectionHead from '../../components/SectionHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import FeatureSection from '../../components/FeatureSection.astro';
import { services, type Service } from '../../data/services';
import { url } from '../../lib/paths';
import { brandify } from '../../lib/brand';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props { service: Service }
const { service } = Astro.props;
---
<BaseLayout title={service.seoTitle} description={service.description}>
  <PageHero title={service.h1} intro={service.intro} art={service.slug as ArtName} />

  <section class="section familiar" aria-labelledby="familiar-heading">
    <div class="wrap split">
      <SectionHead id="familiar-heading" text="Sound familiar?" />
      <ul class="chevron-list chevron-list--large split__body">
        {service.familiar.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <FeatureSection
    id="do-heading"
    heading="What we do"
    items={service.whatWeDo.map((item) => ({ lead: item.term, text: item.text }))}
    leadSuffix=":"
    ordered={false}
  />

  <section class="section get" aria-labelledby="get-heading">
    <div class="wrap">
      <SectionHead id="get-heading" text="What you get" />
      <ul class="get__grid">
        {service.whatYouGet.map((item) => (
          <li class="tile-dark get__item">
            <svg class="get__mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
              <polygon points="9,12 18,12 28,24 18,36 9,36 19,24" fill="#F59E0B" />
              <polygon points="22,12 30,12 40,24 30,36 22,36 32,24" fill="#5EEAD4" />
            </svg>
            <p>{item}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section on-paper" aria-labelledby="experience-heading">
    <div class="wrap split">
      <SectionHead id="experience-heading" text="Where our experience comes from" />
      <div class="experience split__body">
        <p set:html={brandify(service.experience)} />
      </div>
    </div>
  </section>

  <CtaBand button={service.cta} href={url('contact/')} />
</BaseLayout>

<style>
  .split {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 60em) {
    .split {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: clamp(3rem, 6vw, 7rem);
      align-items: start;
    }
  }

  .split__body {
    max-width: var(--measure);
  }

  .familiar {
    background: linear-gradient(180deg, var(--ink) 0%, #0c2529 100%);
  }

  .get__grid {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40em) {
    .get__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64em) {
    .get__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .get__item {
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }

  .get__mark {
    width: 2.5rem;
    height: 2.5rem;
  }

  .get__item p {
    color: var(--white);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .experience {
    margin: 0;
    padding-left: clamp(1.25rem, 3vw, 2rem);
    border-left: 4px solid var(--amber);
  }

  .experience p {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.75rem);
    font-weight: 700;
    line-height: 1.35;
    color: var(--ink);
  }
</style>
