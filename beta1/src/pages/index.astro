---
// Home – copy from brief/website-content.pdf ("Home page"), with the hero line and
// meta description from brief/copy-changes.md.
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ArrowLink from '../components/ArrowLink.astro';
import SectionHead from '../components/SectionHead.astro';
import Chevron from '../components/Chevron.astro';
import HeroArt from '../components/HeroArt.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import Monogram from '../components/Monogram.astro';
import StepTrack from '../components/StepTrack.astro';
import CtaBand from '../components/CtaBand.astro';
import { url } from '../lib/paths';
import { brandify } from '../lib/brand';

const why = [
  {
    lead: 'Senior people, start to finish.',
    text: 'Two founders with 60 years of combined experience. The people who scope your work lead its delivery.',
  },
  {
    lead: 'We know how national health programmes work.',
    text: 'More than a decade delivering NHS England and NHS Improvement data, cloud and digital programmes.',
  },
  {
    lead: 'Data and digital first, so AI holds up.',
    text: 'We build the platforms, data and controls AI needs, then test use cases against real benefits.',
  },
  {
    lead: 'Delivery and commercial sense together.',
    text: 'Experience of running a UK technology services business and large NHS delivery portfolios. Realistic plans, clear contracts, no surprises.',
  },
  {
    lead: 'Easy to work with.',
    text: 'Small and partner-friendly. We fit your teams and standards, and leave knowledge behind.',
  },
];

const services = [
  { name: 'Data and platforms', icon: 'data', line: 'Reliable, governed data that services and AI can depend on.', path: 'services/data-and-platforms/' },
  { name: 'AI to benefit', icon: 'ai', line: 'Choose the right use cases, test them safely and prove the benefit before you scale.', path: 'services/ai-to-benefit/' },
  { name: 'Digital transformation', icon: 'digital', line: 'Redesign services and processes, modernise platforms and automate the routine.', path: 'services/digital-transformation/' },
  { name: 'Delivery assurance', icon: 'assurance', line: 'Steady programmes, clear governance and an honest view of risk.', path: 'services/delivery-assurance/' },
] as const;

const steps = [
  { lead: 'Understand', text: 'we start with your service, your data and the outcome you need.' },
  { lead: 'Prove', text: 'we test the idea quickly, against measures agreed up front.' },
  { lead: 'Scale or stop', text: "we scale what works, stop what doesn't, and leave your team able to run it." },
];

const founders = [
  { name: 'Prahlad Koti', initials: 'PK', text: 'Co-founder and Managing Director – former UK Managing Director of Mastek, with more than 30 years in technology services.' },
  { name: 'Deepak Thaper', initials: 'DT', text: 'Co-founder and Delivery & Technology Director – nearly 30 years in technology delivery, including more than a decade on NHS national programmes.' },
];
---
<BaseLayout
  title="AImpetus | Data, digital and AI for public services"
  description="Better digital services, with AI in the engine room. Senior-led data, digital and AI delivery, with deep roots in the NHS and wider UK public sector."
>
  <!-- 1. Hero -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="eyebrow"><Chevron tone="amber" /><span>Data, digital and AI services</span></p>
        <h1 id="hero-heading">Better digital services, with <span class="hero-ai">A<span class="brand-i">I</span></span> in the engine room.</h1>
        <p class="lede hero__lede">We build the data platforms, digital services and governance that let AI work safely in live services. Senior-led, with 60 years of combined experience and deep roots in the NHS and wider UK public sector.</p>
        <div class="hero__actions">
          <Button href={url('contact/')}>Book a 30-minute conversation</Button>
          <ArrowLink href={url('services/')}>See our services</ArrowLink>
        </div>
      </div>
      <div class="hero__art">
        <HeroArt />
      </div>
    </div>
  </section>

  <!-- 2. The problem we solve -->
  <section class="section problem" aria-labelledby="problem-heading">
    <div class="wrap split">
      <div class="problem__head">
        <Chevron class="problem__marker" />
        <h2 id="problem-heading"><span class="problem__easy">A<span class="brand-i">I</span> is easy to pilot.</span> <span class="problem__hard">Hard to run.</span></h2>
      </div>
      <div class="problem__body">
        <p class="lede">Most organisations have tried AI. Far fewer have it working in a live service. The usual blockers aren't the AI itself. They're scattered data, ageing platforms, unclear governance and programmes stretched thin. We fix the groundwork, so AI and digital change can hold up in the real world.</p>
      </div>
    </div>
  </section>

  <!-- 3. Why AImpetus -->
  <section class="section on-paper why" aria-labelledby="why-heading">
    <div class="wrap">
      <SectionHead id="why-heading" text="A new company. A proven team." />
      <ol class="why__grid">
        {why.map((item, i) => (
          <li class="why__card">
            <span class="why__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <p><strong>{item.lead}</strong> {item.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. What we do -->
  <section class="section services" aria-labelledby="services-heading">
    <div class="wrap">
      <SectionHead id="services-heading" text="Four services, one aim: services that work better." />
      <ul class="services__grid">
        {services.map((service) => (
          <li class="tile">
            <ServiceIcon name={service.icon} />
            <h3 class="tile__name">
              <a href={url(service.path)} class="tile__link" set:html={brandify(service.name)} />
            </h3>
            <p class="tile__line">{service.line}</p>
            <Chevron class="tile__chevron" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. How we work (summary) -->
  <section class="section how" aria-labelledby="how-heading">
    <div class="wrap">
      <SectionHead id="how-heading" text="Start small. Prove it. Then scale." />
      <StepTrack steps={steps} />
      <ArrowLink href={url('how-we-work/')} class="section-link">How we work</ArrowLink>
    </div>
  </section>

  <!-- 6. Founders -->
  <section class="section on-paper founders" aria-labelledby="founders-heading">
    <div class="wrap">
      <SectionHead id="founders-heading" text="Led by the people who do the work" />
      <ul class="founders__grid">
        {founders.map((f) => (
          <li class="founder">
            <Monogram initials={f.initials} />
            <p><strong>{f.name}<span class="visually-hidden">,</span></strong> {f.text}</p>
          </li>
        ))}
      </ul>
      <ArrowLink href={url('about/')} class="section-link">Meet the founders</ArrowLink>
    </div>
  </section>

  <!-- 7. Closing call to action -->
  <CtaBand
    heading="Got a data, AI or digital challenge?"
    text="Tell us what you're working on. In 30 minutes we'll give you an honest view of where to start, even if that isn't with us."
    button="Book a 30-minute conversation"
    href={url('contact/')}
  />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) clamp(3.5rem, 2.5rem + 5vw, 7rem);
    /* Faint engineering grid with a mint glow behind the artwork */
    background:
      radial-gradient(ellipse 60% 70% at 78% 45%, rgba(94, 234, 212, 0.1), transparent 70%),
      linear-gradient(to right, rgba(94, 234, 212, 0.05) 1px, transparent 1px) 0 0 / 64px 64px,
      linear-gradient(to bottom, rgba(94, 234, 212, 0.05) 1px, transparent 1px) 0 0 / 64px 64px,
      var(--ink);
  }

  .hero::after {
    /* Fade the grid out towards the bottom */
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 40%;
    background: linear-gradient(to bottom, transparent, var(--ink));
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .hero__art {
    width: min(100%, 20rem);
    justify-self: center;
  }

  @media (min-width: 60em) {
    .hero__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2rem, 4vw, 4rem);
    }

    .hero__art {
      width: 100%;
      max-width: 34rem;
    }
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
    color: var(--mint);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 14ch;
  }

  .hero-ai {
    color: var(--mint);
  }

  .hero__lede {
    max-width: 38rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    font-size: clamp(1.1875rem, 1.05rem + 0.6vw, 1.5rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  /* ---------- Shared ---------- */
  .split {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 60em) {
    .split {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      column-gap: clamp(3rem, 6vw, 7rem);
      align-items: end;
    }
  }

  .section-link {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  /* ---------- Problem ---------- */
  .problem {
    background: linear-gradient(180deg, var(--ink) 0%, #0c2529 100%);
  }

  .problem :global(.problem__marker) {
    display: block;
    width: 1rem;
    height: 1.2rem;
    margin-bottom: 1.25rem;
  }

  .problem h2 {
    font-size: var(--step-4);
    line-height: 1.02;
  }

  .problem__easy {
    display: block;
    color: var(--muted-on-ink);
  }

  .problem__hard {
    display: block;
    color: var(--mint);
  }

  .problem__body {
    max-width: var(--measure);
    padding-left: 1.5rem;
    border-left: 3px solid var(--amber);
  }

  /* ---------- Why (paper) ---------- */
  .why__grid {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40em) {
    .why__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64em) {
    .why__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .why__card {
      grid-column: span 2;
    }

    /* 3 + 2 layout: the last two cards share the second row */
    .why__card:nth-child(4),
    .why__card:nth-child(5) {
      grid-column: span 3;
    }
  }

  .why__card {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2rem);
    padding-top: clamp(1.25rem, 2.5vw, 1.75rem);
    border: 1px solid var(--rule-on-paper);
    border-radius: 1rem;
    background: var(--white);
    box-shadow: 0 1px 0 rgba(14, 42, 47, 0.04), 0 12px 32px -18px rgba(14, 42, 47, 0.25);
  }

  .why__card::before {
    content: '';
    position: absolute;
    top: -1px;
    left: clamp(1.5rem, 3vw, 2rem);
    width: 2.5rem;
    height: 4px;
    border-radius: 0 0 4px 4px;
    background: var(--teal);
  }

  .why__num {
    display: block;
    margin-bottom: 0.75rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(2.25rem, 1.8rem + 1.5vw, 3rem);
    line-height: 1;
    color: var(--teal);
  }

  .why__card strong {
    display: block;
    margin-bottom: 0.375rem;
    font-size: 1.125rem;
  }

  /* ---------- Services ---------- */
  .services {
    background:
      radial-gradient(ellipse 50% 60% at 10% 0%, rgba(94, 234, 212, 0.08), transparent 70%),
      var(--ink);
  }

  .services__grid {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48em) {
    .services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .tile {
    position: relative;
    display: grid;
    align-content: start;
    gap: 1rem;
    min-height: 15rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid #24484e;
    border-radius: 1rem;
    background: linear-gradient(160deg, #15393f 0%, #102e33 100%);
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .tile:hover,
  .tile:focus-within {
    border-color: var(--mint);
    transform: translateY(-3px);
    box-shadow: 0 18px 40px -20px rgba(94, 234, 212, 0.35);
  }

  .tile__name {
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
  }

  .tile__link {
    color: var(--white);
    text-decoration: none;
  }

  /* Whole tile is clickable; the link keeps the accessible name */
  .tile__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 1rem;
  }

  .tile__link:hover {
    color: var(--white);
  }

  .tile:hover .tile__link {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .tile__link:focus-visible {
    outline: none;
  }

  .tile__link:focus-visible::after {
    outline: var(--focus-width) solid var(--white);
    outline-offset: 3px;
  }

  .tile__line {
    max-width: 30rem;
    color: var(--muted-on-ink);
  }

  .tile :global(.tile__chevron) {
    position: absolute;
    top: clamp(1.5rem, 3vw, 2.25rem);
    right: clamp(1.5rem, 3vw, 2.25rem);
    width: 1rem;
    height: 1.2rem;
    transition: transform 0.2s ease;
  }

  .tile:hover :global(.tile__chevron) {
    transform: translateX(4px);
  }

  /* ---------- Founders (paper) ---------- */
  .founders__grid {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48em) {
    .founders__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .founder {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid var(--rule-on-paper);
    border-radius: 1rem;
    background: var(--white);
    box-shadow: 0 12px 32px -18px rgba(14, 42, 47, 0.25);
  }

  .founder strong {
    display: block;
    margin-bottom: 0.25rem;
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 700;
  }

  @media (max-width: 26em) {
    .founder {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
