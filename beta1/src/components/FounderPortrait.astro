---
// Founder photo if one exists in src/assets/founders/<slug>.(jpg|jpeg|png|webp),
// otherwise the monogram badge. Photos are cropped square and served as AVIF/WebP.
// The portrait is decorative: the founder's name is always shown next to it.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Monogram from './Monogram.astro';

interface Props { slug: string; initials: string; size?: 'sm' | 'md' | 'lg' }
const { slug, initials, size = 'md' } = Astro.props;

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/founders/*.{jpg,jpeg,png,webp}', { eager: true });
const photo = Object.entries(photos).find(([path]) => path.split('/').pop()?.replace(/\.\w+$/, '') === slug)?.[1]?.default;
const px = { sm: 112, md: 176, lg: 320 }[size];
---
{photo ? (
  <div class:list={['portrait', `portrait--${size}`]}>
    <Picture
      src={photo}
      alt=""
      width={px}
      height={px}
      densities={[1, 2]}
      formats={['avif', 'webp']}
      fit="cover"
      position="top"
      loading={size === 'lg' ? 'eager' : 'lazy'}
      class="portrait__img"
    />
    <svg viewBox="0 0 48 48" class="portrait__mark" aria-hidden="true" focusable="false">
      <polygon points="9,12 18,12 28,24 18,36 9,36 19,24" fill="#F59E0B" />
      <polygon points="22,12 30,12 40,24 30,36 22,36 32,24" fill="#5EEAD4" />
    </svg>
  </div>
) : (
  <Monogram initials={initials} />
)}

<style>
  .portrait {
    position: relative;
    flex: none;
    width: 5.5rem;
    aspect-ratio: 1;
  }

  .portrait--md {
    width: 7rem;
  }

  .portrait--lg {
    width: 100%;
  }

  .portrait :global(.portrait__img) {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 1.25rem;
    object-fit: cover;
    box-shadow: 0 0 0 1px #3b6168, 0 18px 40px -20px rgba(0, 0, 0, 0.6);
  }

  .portrait__mark {
    position: absolute;
    right: -0.6rem;
    bottom: -0.6rem;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.2rem;
    border-radius: 0.6rem;
    background: var(--ink);
    box-shadow: 0 0 0 3px var(--white);
  }
</style>
