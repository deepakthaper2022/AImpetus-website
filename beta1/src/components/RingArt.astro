---
// Interior page artwork: gauge rings around a service icon or the brand chevrons.
// Decorative only.
import type { IconName } from '../data/services';
import ServiceIcon from './ServiceIcon.astro';
interface Props { icon?: IconName }
const { icon } = Astro.props;
---
<div class="ring-art" aria-hidden="true">
  <svg class="ring-art__rings" viewBox="0 0 400 400" focusable="false">
    <defs>
      <radialGradient id="ra-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#5EEAD4" stop-opacity="0.22" />
        <stop offset="1" stop-color="#0E2A2F" stop-opacity="0" />
      </radialGradient>
    </defs>
    <circle cx="200" cy="200" r="195" fill="url(#ra-glow)" />
    <circle cx="200" cy="200" r="180" fill="none" stroke="#2A4A50" />
    <circle cx="200" cy="200" r="166" fill="none" stroke="#3B6168" stroke-width="8" stroke-dasharray="1.5 12" />
    <path d="M 56 140 A 156 156 0 0 1 344 140" fill="none" stroke="#5EEAD4" stroke-width="3" stroke-linecap="round" />
    <circle cx="344" cy="140" r="5" fill="#5EEAD4" />
    <circle cx="200" cy="380" r="4.5" fill="#F59E0B" />
    <circle cx="200" cy="200" r="110" fill="#0B2328" fill-opacity="0.6" stroke="#5EEAD4" stroke-opacity="0.35" stroke-width="1.5" />
    {!icon && (
      <g transform="translate(200 200) scale(4.6) translate(-24.5 -24)">
        <polygon points="3,12 12,12 22,24 12,36 3,36 13,24" fill="none" stroke="#5EEAD4" stroke-width="0.3" opacity="0.35" />
        <polygon points="9,12 18,12 28,24 18,36 9,36 19,24" fill="#F59E0B" />
        <polygon points="22,12 30,12 40,24 30,36 22,36 32,24" fill="#5EEAD4" />
      </g>
    )}
  </svg>
  {icon && <div class="ring-art__icon"><ServiceIcon name={icon} /></div>}
</div>

<style>
  .ring-art {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }

  .ring-art__rings {
    width: 100%;
    height: 100%;
  }

  .ring-art__icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  .ring-art__icon :global(.service-icon) {
    width: 38%;
    height: 38%;
  }
</style>
