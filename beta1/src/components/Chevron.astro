---
// The brand chevron as a small decorative marker (section markers, list bullets).
interface Props { class?: string; tone?: 'accent' | 'amber' }
const { class: className = '', tone = 'accent' } = Astro.props;
---
<svg class:list={['chevron', `chevron--${tone}`, className]} viewBox="0 0 10 12" aria-hidden="true" focusable="false">
  <polygon points="0,0 4.5,0 10,6 4.5,12 0,12 5.5,6" />
</svg>

<style>
  .chevron {
    display: inline-block;
    flex: none;
    width: 0.6em;
    height: 0.72em;
    fill: var(--accent);
  }

  .chevron--amber {
    fill: var(--amber);
  }

  @media (forced-colors: active) {
    .chevron {
      fill: CanvasText;
    }
  }
</style>
