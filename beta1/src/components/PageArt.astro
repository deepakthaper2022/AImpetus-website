---
// Page-specific hero illustrations, all in the same "engine room" language:
// mint line work, amber accents, ink panels, soft glow. Decorative only.
import ServiceIcon from './ServiceIcon.astro';

export type ArtName =
  | 'services'
  | 'data-and-platforms'
  | 'ai-to-benefit'
  | 'digital-transformation'
  | 'delivery-assurance'
  | 'how-we-work'
  | 'contact'
  | 'insights'
  | 'chevrons';

interface Props { name: ArtName }
const { name } = Astro.props;

const MINT = '#5EEAD4';
const LINE = '#3B6168';
const PANEL = '#13353B';
const DEEP = '#0B2328';
const AMBER = '#F59E0B';
---
<div class:list={['page-art', `page-art--${name}`]} aria-hidden="true">
  <svg viewBox="0 0 400 400" focusable="false">
    <defs>
      <radialGradient id="pa-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color={MINT} stop-opacity="0.2" />
        <stop offset="1" stop-color="#0E2A2F" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="pa-mint" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#99F6E4" />
        <stop offset="1" stop-color="#14B8A6" />
      </linearGradient>
      <linearGradient id="pa-amber" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#FCD34D" />
        <stop offset="1" stop-color="#D97706" />
      </linearGradient>
    </defs>

    <!-- Shared backdrop: glow and a faint gauge ring -->
    <circle cx="200" cy="200" r="195" fill="url(#pa-glow)" />
    <circle cx="200" cy="200" r="182" fill="none" stroke="#2A4A50" />
    <circle cx="200" cy="200" r="170" fill="none" stroke="#2A4A50" stroke-width="6" stroke-dasharray="1.2 14" />

    {name === 'data-and-platforms' && (
      <g>
        <!-- Data flowing down into the platform -->
        <g stroke={MINT} stroke-width="2" stroke-dasharray="3 7" stroke-linecap="round">
          <line x1="160" y1="38" x2="166" y2="104" />
          <line x1="200" y1="28" x2="200" y2="96" />
          <line x1="240" y1="38" x2="234" y2="104" />
        </g>
        <circle cx="161" cy="62" r="5" fill={AMBER} />
        <circle cx="200" cy="48" r="5" fill={MINT} />
        <circle cx="238" cy="72" r="5" fill={MINT} />
        <!-- Three platform layers (bottom to top) -->
        {[270, 210, 150].map((cy, i) => (
          <g>
            <polygon points={`100,${cy} 200,${cy + 50} 200,${cy + 66} 100,${cy + 16}`} fill={DEEP} stroke={LINE} />
            <polygon points={`300,${cy} 200,${cy + 50} 200,${cy + 66} 300,${cy + 16}`} fill={DEEP} stroke={LINE} />
            <polygon
              points={`200,${cy - 50} 300,${cy} 200,${cy + 50} 100,${cy}`}
              fill={PANEL}
              stroke={i === 2 ? MINT : LINE}
              stroke-width={i === 2 ? 2.5 : 1.5}
            />
          </g>
        ))}
        <!-- Grid on the top layer -->
        <g stroke={MINT} stroke-opacity="0.35">
          <line x1="150" y1="125" x2="250" y2="175" />
          <line x1="150" y1="175" x2="250" y2="125" />
        </g>
        <polygon points="182,138 192,138 204,150 192,162 182,162 194,150" fill={AMBER} />
        <polygon points="198,138 208,138 220,150 208,162 198,162 210,150" fill={MINT} />
      </g>
    )}

    {name === 'ai-to-benefit' && (
      <g>
        <line x1="70" y1="315" x2="330" y2="315" stroke={LINE} stroke-width="2" />
        <!-- Pilots (dashed) become live services (solid) -->
        <rect x="88" y="262" width="38" height="53" rx="6" fill="none" stroke={LINE} stroke-width="2" stroke-dasharray="5 5" />
        <rect x="148" y="222" width="38" height="93" rx="6" fill="none" stroke={MINT} stroke-opacity="0.6" stroke-width="2" stroke-dasharray="5 5" />
        <rect x="208" y="172" width="38" height="143" rx="6" fill="url(#pa-mint)" fill-opacity="0.85" />
        <rect x="268" y="118" width="38" height="197" rx="6" fill="url(#pa-mint)" />
        <!-- Benefit trend line ending in a chevron -->
        <polyline points="107,240 167,198 227,150 280,104" fill="none" stroke={AMBER} stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        <g transform="translate(282 100) rotate(-40)">
          <polygon points="-6,-12 4,-12 16,0 4,12 -6,12 6,0" fill={AMBER} />
        </g>
        {[[107, 240], [167, 198], [227, 150]].map(([x, y]) => <circle cx={x} cy={y} r="5" fill="#0E2A2F" stroke={AMBER} stroke-width="2.5" />)}
        <!-- Evidence check -->
        <circle cx="320" cy="72" r="24" fill={DEEP} stroke={MINT} stroke-width="2.5" />
        <polyline points="309,72 317,80 332,64" fill="none" stroke={MINT} stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      </g>
    )}

    {name === 'digital-transformation' && (
      <g>
        <!-- Legacy: rigid grid of boxes -->
        {[0, 1, 2].map((r) => [0, 1, 2].map((c) => (
          <rect
            x={58 + c * 32}
            y={148 + r * 32}
            width="26"
            height="26"
            rx="3"
            fill={(r + c) % 3 === 0 ? PANEL : 'none'}
            stroke={LINE}
            stroke-width="2"
          />
        )))}
        <!-- Change -->
        <polygon points="172,186 182,186 196,200 182,214 172,214 186,200" fill={AMBER} />
        <polygon points="190,186 200,186 214,200 200,214 190,214 204,200" fill={MINT} />
        <!-- Modern: connected, flowing service -->
        <circle cx="290" cy="200" r="58" fill={DEEP} stroke={MINT} stroke-width="2.5" />
        <path d="M 252 214 C 270 170, 310 236, 328 186" fill="none" stroke={MINT} stroke-width="3" stroke-linecap="round" />
        <circle cx="252" cy="214" r="7" fill={MINT} />
        <circle cx="290" cy="200" r="7" fill={AMBER} />
        <circle cx="328" cy="186" r="7" fill={MINT} />
        <!-- Shared foundation -->
        <line x1="58" y1="300" x2="342" y2="300" stroke={LINE} stroke-width="2" stroke-dasharray="4 8" />
        <circle cx="106" cy="300" r="6" fill="none" stroke={LINE} stroke-width="2" />
        <circle cx="290" cy="300" r="6" fill={MINT} />
      </g>
    )}

    {name === 'delivery-assurance' && (
      <g>
        <!-- Dial: risk to confidence -->
        <path d="M 70 230 A 130 130 0 0 1 330 230" fill="none" stroke="#2A4A50" stroke-width="20" />
        <path d="M 70 230 A 130 130 0 0 1 135 117.4" fill="none" stroke={AMBER} stroke-width="20" stroke-opacity="0.75" />
        <path d="M 265 117.4 A 130 130 0 0 1 330 230" fill="none" stroke={MINT} stroke-width="20" />
        <g stroke={LINE} stroke-width="2">
          {[30, 60, 90, 120, 150].map((deg) => {
            const t = (deg * Math.PI) / 180;
            return <line x1={200 + 100 * Math.cos(t)} y1={230 - 100 * Math.sin(t)} x2={200 + 88 * Math.cos(t)} y2={230 - 88 * Math.sin(t)} />;
          })}
        </g>
        <line x1="200" y1="230" x2="284" y2="160" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" />
        <circle cx="200" cy="230" r="12" fill={DEEP} stroke={MINT} stroke-width="3" />
        <!-- Milestones on track -->
        <line x1="90" y1="318" x2="310" y2="318" stroke={LINE} stroke-width="2" />
        {[90, 163, 236].map((x) => (
          <g>
            <circle cx={x} cy="318" r="12" fill={MINT} />
            <polyline points={`${x - 5},318 ${x - 1},322 ${x + 6},313`} fill="none" stroke="#0E2A2F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          </g>
        ))}
        <circle cx="310" cy="318" r="12" fill={DEEP} stroke={MINT} stroke-width="2.5" />
      </g>
    )}

    {name === 'how-we-work' && (
      <g>
        <!-- Understand → Prove → Scale or stop -->
        <path d="M 86 296 C 150 296, 140 196, 200 196 S 250 104, 314 104" fill="none" stroke={MINT} stroke-opacity="0.55" stroke-width="3" stroke-dasharray="2 9" stroke-linecap="round" />
        <path d="M 86 296 C 150 296, 140 196, 200 196" fill="none" stroke={MINT} stroke-width="3" stroke-linecap="round" />
        {[[86, 296, '1', false], [200, 196, '2', false], [314, 104, '3', true]].map(([x, y, n, last]) => (
          <g>
            <circle cx={x} cy={y} r="28" fill={last ? 'url(#pa-mint)' : DEEP} stroke={MINT} stroke-width="2.5" />
            <text x={x} y={Number(y) + 8} text-anchor="middle" font-family="Space Grotesk, sans-serif" font-weight="700" font-size="24" fill={last ? '#0E2A2F' : MINT}>{n}</text>
          </g>
        ))}
        <!-- Scale (up) or stop -->
        <g transform="translate(352 64) rotate(-45)">
          <polygon points="-7,-11 3,-11 14,0 3,11 -7,11 4,0" fill={MINT} />
        </g>
        <g stroke={AMBER} stroke-width="3" stroke-linecap="round">
          <line x1="342" y1="146" x2="356" y2="160" />
          <line x1="356" y1="146" x2="342" y2="160" />
        </g>
      </g>
    )}

    {name === 'contact' && (
      <g>
        <!-- Calendar with a chosen slot -->
        <rect x="150" y="92" width="190" height="168" rx="16" fill={PANEL} stroke={LINE} stroke-width="2" />
        <rect x="150" y="92" width="190" height="38" rx="16" fill={MINT} fill-opacity="0.18" />
        <line x1="190" y1="80" x2="190" y2="104" stroke={MINT} stroke-width="4" stroke-linecap="round" />
        <line x1="300" y1="80" x2="300" y2="104" stroke={MINT} stroke-width="4" stroke-linecap="round" />
        {[0, 1, 2].map((r) => [0, 1, 2, 3].map((c) => (
          <rect
            x={168 + c * 40}
            y={146 + r * 36}
            width="30"
            height="24"
            rx="5"
            fill={r === 1 && c === 2 ? AMBER : 'none'}
            stroke={r === 1 && c === 2 ? AMBER : LINE}
            stroke-width="1.5"
          />
        )))}
        <!-- Conversation -->
        <path d="M 60 214 h 120 a 18 18 0 0 1 18 18 v 44 a 18 18 0 0 1 -18 18 h -86 l -22 20 v -20 h -12 a 18 18 0 0 1 -18 -18 v -44 a 18 18 0 0 1 18 -18 z" fill={DEEP} stroke={MINT} stroke-width="2.5" />
        <line x1="66" y1="244" x2="166" y2="244" stroke={MINT} stroke-width="4" stroke-linecap="round" />
        <line x1="66" y1="264" x2="138" y2="264" stroke={LINE} stroke-width="4" stroke-linecap="round" />
        <path d="M 232 292 h 96 a 16 16 0 0 1 16 16 v 26 a 16 16 0 0 1 -16 16 h -10 v 16 l -20 -16 h -66 a 16 16 0 0 1 -16 -16 v -26 a 16 16 0 0 1 16 -16 z" fill="url(#pa-mint)" />
        <line x1="236" y1="318" x2="318" y2="318" stroke="#0E2A2F" stroke-width="4" stroke-linecap="round" />
      </g>
    )}

    {name === 'insights' && (
      <g>
        <!-- A stack of articles -->
        <rect x="118" y="96" width="176" height="224" rx="14" fill={DEEP} stroke={LINE} stroke-width="2" transform="rotate(-8 206 208)" />
        <rect x="118" y="96" width="176" height="224" rx="14" fill={DEEP} stroke={LINE} stroke-width="2" transform="rotate(5 206 208)" />
        <rect x="112" y="88" width="176" height="224" rx="14" fill={PANEL} stroke={MINT} stroke-width="2.5" />
        <rect x="132" y="112" width="136" height="64" rx="8" fill={MINT} fill-opacity="0.14" stroke={MINT} stroke-opacity="0.5" />
        <polygon points="186,128 196,128 208,144 196,160 186,160 198,144" fill={AMBER} />
        <polygon points="200,128 210,128 222,144 210,160 200,160 212,144" fill={MINT} />
        <line x1="132" y1="200" x2="256" y2="200" stroke={MINT} stroke-width="5" stroke-linecap="round" />
        {[226, 248, 270].map((y, i) => <line x1="132" y1={y} x2={i === 2 ? 210 : 266} y2={y} stroke={LINE} stroke-width="4" stroke-linecap="round" />)}
        <!-- Bookmark -->
        <path d="M 252 88 v 40 l 12 -10 l 12 10 v -40 z" fill={AMBER} />
      </g>
    )}

    {name === 'chevrons' && (
      <g transform="translate(200 200) scale(4.6) translate(-24.5 -24)">
        <polygon points="3,12 12,12 22,24 12,36 3,36 13,24" fill="none" stroke={MINT} stroke-width="0.3" opacity="0.35" />
        <polygon points="9,12 18,12 28,24 18,36 9,36 19,24" fill="url(#pa-amber)" />
        <polygon points="22,12 30,12 40,24 30,36 22,36 32,24" fill="url(#pa-mint)" />
      </g>
    )}

    {name === 'services' && (
      <g>
        <!-- Four services orbiting the mark -->
        <circle cx="200" cy="200" r="120" fill="none" stroke={MINT} stroke-opacity="0.45" stroke-width="2" stroke-dasharray="4 8" />
        <circle cx="200" cy="200" r="52" fill={DEEP} stroke={MINT} stroke-width="2" />
        <g transform="translate(200 200) scale(2.2) translate(-24.5 -24)">
          <polygon points="9,12 18,12 28,24 18,36 9,36 19,24" fill={AMBER} />
          <polygon points="22,12 30,12 40,24 30,36 22,36 32,24" fill={MINT} />
        </g>
      </g>
    )}
  </svg>

  {name === 'services' && (
    <>
      <span class="orbit orbit--n"><ServiceIcon name="data" /></span>
      <span class="orbit orbit--e"><ServiceIcon name="ai" /></span>
      <span class="orbit orbit--s"><ServiceIcon name="digital" /></span>
      <span class="orbit orbit--w"><ServiceIcon name="assurance" /></span>
    </>
  )}
</div>

<style>
  .page-art {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }

  .page-art svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Service icons placed on the orbit (radius 120 of a 400 box = 30%) */
  .orbit {
    position: absolute;
    display: grid;
    place-items: center;
    width: 19%;
    aspect-ratio: 1;
    border: 1px solid #2f5a60;
    border-radius: 22%;
    background: linear-gradient(160deg, #15393f, #0b2328);
    box-shadow: 0 10px 30px -12px rgba(94, 234, 212, 0.35);
    transform: translate(-50%, -50%);
  }

  .orbit :global(.service-icon) {
    width: 64%;
    height: 64%;
  }

  .orbit--n { left: 50%; top: 20%; }
  .orbit--e { left: 80%; top: 50%; }
  .orbit--s { left: 50%; top: 80%; }
  .orbit--w { left: 20%; top: 50%; }
</style>
