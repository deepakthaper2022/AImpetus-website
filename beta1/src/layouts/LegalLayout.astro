---
// Privacy, cookie and accessibility pages: ink title band, paper reading area.
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Placeholder from '../components/Placeholder.astro';
interface Props { title: string; heading: string; description?: string }
const { title, heading, description } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <PageHero title={heading} art={false}>
    <p class="updated">Last updated: <Placeholder text="publication date" /></p>
  </PageHero>
  <section class="section on-paper legal">
    <div class="wrap">
      <div class="prose">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .updated {
    margin-top: 1.25rem;
    color: var(--muted-on-ink);
    font-weight: 600;
  }

  .legal {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem);
  }
</style>
